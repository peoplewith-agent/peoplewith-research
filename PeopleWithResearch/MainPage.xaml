<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <ContentPage.Content>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Language button — top-right corner -->
            <Button
                x:Name="btnLanguage"
                Grid.Row="0"
                HorizontalOptions="End"
                VerticalOptions="Start"
                Margin="0,20,20,0"
                ZIndex="10"
                Text="🌐"
                FontSize="22"
                BackgroundColor="Transparent"
                TextColor="#031926"
                Clicked="btnLanguage_Clicked" />

            <ScrollView x:Name="mainscroll" Grid.Row="0">

                <StackLayout>

                    <Image
                        x:Name="mainimg"
                        Margin="0,20,0,0"
                        BackgroundColor="Transparent"
                        HeightRequest="200"
                        HorizontalOptions="Center"
                        Source="peoplewithresearchlogowhite.png"
                        VerticalOptions="Start"
                        WidthRequest="200" />


                    <Label
                        x:Name="mainlbl"
                        Margin="0,0,0,0"
                        FontAttributes="Bold"
                        FontSize="30"
                        HorizontalOptions="Center"
                        Text="Your Research Code"
                        TextColor="Black" />

                    <Label
                        Margin="20,0,20,0"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span
                                    FontSize="18"
                                    Text="Thank you for your interest in taking part, if you have copied a code "
                                    TextColor="Gray" />
                                <Span
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    Text="Tap on the 'Paste Research Code' button and accept the on-screen prompt."
                                    TextColor="Gray" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>


                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>


                        <!--<inputLayout:SfTextInputLayout
ContainerType="Filled" FocusedColor="White" ContainerBackgroundColor="White" HorizontalOptions="CenterAndExpand" Opacity="0.7" UnfocusedColor="#009fe3"
Hint="" Margin="20,20,20,0"
Grid.Row="0" Grid.Column="0"
ReserveSpaceForAssistiveLabels="False">
<local:HideKeyboardEntry x:Name="pasteentry" Focused="pasteentry_Focused"  Placeholder="" HorizontalTextAlignment="Center" TextColor="Black" FontSize="12" />
</inputLayout:SfTextInputLayout>-->

                        <Label
                            x:Name="pasteentry"
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="20,20,20,0"
                            FontAttributes="None"
                            FontSize="14"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text=""
                            TextColor="Black" />

                        <BoxView
                            Grid.Row="1"
                            Grid.Column="0"
                            Margin="20,10,20,0"
                            HeightRequest="1"
                            HorizontalOptions="FillAndExpand"
                            Color="#009fe3" />

                        <Button
                            x:Name="clearbtn"
                            Grid.Row="2"
                            Grid.Column="0"
                            Margin="0,10,0,0"
                            Padding="5"
                            BackgroundColor="Transparent"
                            BorderColor="LightGray"
                            BorderWidth="1"
                            Clicked="clearbtn_Clicked"
                            CornerRadius="5"
                            FontAttributes="Bold"
                            HeightRequest="30"
                            HorizontalOptions="Center"
                            IsVisible="false"
                            Text="CLEAR"
                            TextColor="Gray"
                            VerticalOptions="Center" />


                        <Button
                            x:Name="pastebtn"
                            Grid.Row="3"
                            Margin="20,10,20,0"
                            Padding="0"
                            Background="#009fe3"
                            Clicked="TapGestureRecognizer_Tapped"
                            CornerRadius="5"
                            FontAttributes="Bold"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="true"
                            Text="Paste Research Code"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Label
                            x:Name="reglbl"
                            Grid.Row="4"
                            Margin="20,20,20,0"
                            FontAttributes="None"
                            FontSize="14"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Have your details for a project? Register below:"
                            TextColor="Gray" />

                        <Button
                            x:Name="regbtn"
                            Grid.Row="5"
                            Margin="20,5,20,0"
                            Padding="0,0,0,0"
                            Background="#0d4a87"
                            BorderColor="#0d4a87"
                            BorderWidth="1"
                            Clicked="Button_Clicked"
                            CornerRadius="5"
                            FontAttributes="Bold"
                            HeightRequest="35"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="true"
                            Text="Register With Details"
                            TextColor="White"
                            VerticalOptions="Center" />




                        <Label
                            x:Name="loginlbl"
                            Grid.Row="6"
                            Margin="20,20,20,0"
                            FontAttributes="None"
                            FontSize="14"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Already registered for a project? Login below:"
                            TextColor="Gray" />

                        <Button
                            x:Name="loginbtn"
                            Grid.Row="7"
                            Margin="20,5,20,0"
                            Padding="0,0,0,0"
                            Background="White"
                            BorderColor="#009fe3"
                            BorderWidth="1"
                            Clicked="TapGestureRecognizer_Tapped_Login"
                            CornerRadius="5"
                            FontAttributes="Bold"
                            HeightRequest="35"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="true"
                            Text="Login"
                            TextColor="#009fe3"
                            VerticalOptions="Center" />


                        <!--<Image Source="paste.png" BackgroundColor="Transparent" HeightRequest="50" WidthRequest="50" Margin="0,25,0,0" Grid.Row="0" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" >
    <Image.GestureRecognizers>
        <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>

    </Image.GestureRecognizers>
</Image>-->

                    </Grid>

                    <!--  Checking stack  -->

                    <StackLayout
                        x:Name="checkingstack"
                        Margin="0,15,0,15"
                        Padding="10"
                        BackgroundColor="White"
                        IsVisible="false">


                        <Image
                            x:Name="tickloader"
                            Margin="0,0,0,0"
                            BackgroundColor="Transparent"
                            HeightRequest="40"
                            HorizontalOptions="Center"
                            IsVisible="false"
                            Source="tick.png"
                            VerticalOptions="Start"
                            WidthRequest="40" />
                        <ActivityIndicator
                            x:Name="loader"
                            HorizontalOptions="CenterAndExpand"
                            IsRunning="True"
                            VerticalOptions="StartAndExpand"
                            Color="#009fe3" />
                        <Label
                            x:Name="loaderlabel"
                            Margin="10,0,10,0"
                            FontAttributes="Bold"
                            FontSize="18"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="Checking code..."
                            TextColor="Black" />

                        <Button
                            x:Name="tryagainbutton"
                            Padding="25,0,25,0"
                            Background="#009fe3"
                            Clicked="tryagainbutton_Clicked"
                            CornerRadius="5"
                            FontAttributes="Bold"
                            HeightRequest="35"
                            HorizontalOptions="Center"
                            IsVisible="false"
                            Text="Try Again"
                            TextColor="White"
                            VerticalOptions="Center" />

                        <Grid Margin="20,20,10,0" IsVisible="false">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="90*" />
                            </Grid.ColumnDefinitions>

                            <Image
                                x:Name="tick1"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,0,0"
                                BackgroundColor="Transparent"
                                HeightRequest="20"
                                HorizontalOptions="Center"
                                Opacity="0.2"
                                Source="tick.png"
                                VerticalOptions="Start"
                                WidthRequest="20" />
                            <Label
                                x:Name="label1"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="0,0,0,0"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Start"
                                Opacity="0.2"
                                Text="Validating your user code to ensure a secure and efficient login experience"
                                TextColor="Black" />


                            <Image
                                x:Name="tick2"
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="0,20,0,0"
                                BackgroundColor="Transparent"
                                HeightRequest="20"
                                HorizontalOptions="Center"
                                Opacity="0.2"
                                Source="tick.png"
                                VerticalOptions="Start"
                                WidthRequest="20" />
                            <Label
                                x:Name="label2"
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="0,20,0,0"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Start"
                                Opacity="0.2"
                                Text="Checking for any duplications in our system"
                                TextColor="Black" />


                            <Image
                                x:Name="tick3"
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,20,0,0"
                                BackgroundColor="Transparent"
                                HeightRequest="20"
                                HorizontalOptions="Center"
                                Opacity="0.2"
                                Source="tick.png"
                                VerticalOptions="Start"
                                WidthRequest="20" />
                            <Label
                                x:Name="label3"
                                Grid.Row="2"
                                Grid.Column="1"
                                Margin="0,20,0,0"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="Start"
                                HorizontalTextAlignment="Start"
                                Opacity="0.2"
                                Text="Success!"
                                TextColor="Black" />



                        </Grid>



                    </StackLayout>


                </StackLayout>

            </ScrollView>

            <StackLayout
                x:Name="bottomstack"
                Grid.Row="1"
                Margin="0,0,0,20"
                BackgroundColor="White"
                IsVisible="false"
                VerticalOptions="EndAndExpand">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button
                        x:Name="btnmain"
                        Grid.Row="0"
                        Margin="20,0,20,0"
                        BackgroundColor="#009fe3"
                        Clicked="btnmain_Clicked"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        HeightRequest="40"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="true"
                        Text="NEXT"
                        TextColor="White"
                        WidthRequest="80" />

                    <Button
                        x:Name="btnskip"
                        Grid.Row="1"
                        Margin="20,0,20,0"
                        BackgroundColor="White"
                        CornerRadius="10"
                        FontAttributes="Bold"
                        HeightRequest="40"
                        HorizontalOptions="FillAndExpand"
                        IsVisible="false"
                        Text="Skip for now"
                        TextColor="Black" />


                </Grid>



            </StackLayout>

        </Grid>
    </ContentPage.Content>
</ContentPage>
