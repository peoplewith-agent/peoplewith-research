<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.pdfpage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:PeopleWithResearch"
    xmlns:strings="clr-namespace:PeopleWithResearch.Resources.Strings;assembly=PeopleWithResearch"
    xmlns:syncfusionpdf="clr-namespace:Syncfusion.Maui.PdfViewer;assembly=Syncfusion.Maui.PdfViewer">
    <Grid>

        <!--  PDF Viewer  -->
        <syncfusionpdf:SfPdfViewer x:Name="pdfViewer" />

        <!--  Close Button  -->
        <Button
            Margin="20"
            Padding="10"
            BackgroundColor="#009fe3"
            Clicked="Button_Clicked"
            CornerRadius="10"
            HorizontalOptions="Start"
            Text="{loc:Localize Key=Pdf_Close}"
            TextColor="White"
            VerticalOptions="Start" />

    </Grid>
</ContentPage>