<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.QuestionnairePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:Syncfusion.Maui.DataSource;assembly=Syncfusion.Maui.DataSource"
    xmlns:local="clr-namespace:PeopleWithResearch"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:syncfusion1="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    BackgroundColor="#Eff0f7"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <syncfusion1:SfRadioGroupKey x:Key="keyone" />
        <syncfusion1:SfRadioGroupKey x:Key="keytwo" />
        <syncfusion1:SfRadioGroupKey x:Key="keythree" />
        <syncfusion1:SfRadioGroupKey x:Key="keyfour" />
        <syncfusion1:SfRadioGroupKey x:Key="keyfive" />
        <syncfusion1:SfRadioGroupKey x:Key="optionkey" />
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem
            x:Name="toolbar"
            Clicked="ToolbarItem_Clicked"
            Text="" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>

        <Grid>

            <StackLayout x:Name="noconnection" IsVisible="false">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                        <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>

                    <Image
                        x:Name="nodatahomeimg"
                        Grid.Row="0"
                        Margin="10,250,10,0"
                        HeightRequest="80"
                        HorizontalOptions="Center"
                        Source="networkerror.png"
                        WidthRequest="80" />

                    <Label
                        Grid.Row="1"
                        Margin="0,-5,0,0"
                        FontAttributes="None"
                        FontSize="Micro"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="You seem to have lost connection"
                        TextColor="Gray" />

                    <Label
                        Grid.Row="2"
                        Margin="0,-5,0,0"
                        FontAttributes="None"
                        FontSize="Micro"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="Please check your connection and try again"
                        TextColor="Gray" />

                </Grid>
            </StackLayout>

            <StackLayout x:Name="mainstack">
                <Label
                    x:Name="progresslbl"
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontSize="12"
                    HorizontalOptions="Center"
                    IsVisible="false"
                    Text="Questionnaire Progress"
                    TextColor="Black"
                    VerticalOptions="Center"
                    VerticalTextAlignment="Center" />
                <progressBar:SfLinearProgressBar
                    x:Name="questionnaireprogressbar"
                    Margin="10,0,10,10"
                    HeightRequest="10"
                    IsVisible="false"
                    Maximum="100"
                    Minimum="0"
                    Progress="0"
                    ProgressCornerRadius="5"
                    ProgressFill="#009fe3"
                    TrackCornerRadius="5"
                    TrackHeight="10" />
                <ScrollView x:Name="scroll" VerticalOptions="StartAndExpand">
                    <!--<ScrollView.Behaviors>
                        <anim:ScrollViewScrollBehavior x:Name="Scroll" />
                    </ScrollView.Behaviors>-->


                    <StackLayout VerticalOptions="FillAndExpand">

                        <StackLayout
                            x:Name="loadingstack"
                            IsVisible="false"
                            VerticalOptions="CenterAndExpand">
                            <ActivityIndicator IsRunning="True" />
                            <Label
                                Margin="0,0,0,0"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="Center"
                                Text="Loading Questionnaire..."
                                TextColor="Black" />

                        </StackLayout>

                        <StackLayout x:Name="neitherstack" IsVisible="false">
                            <Image
                                Margin="0,20,0,5"
                                HeightRequest="50"
                                HorizontalOptions="CenterAndExpand"
                                Source="questionnaireicon.png"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="50" />


                            <Label
                                Margin="20,0,20,0"
                                FontAttributes="Bold"
                                FontSize="22"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="Weekly Follow-Up Response"
                                TextColor="Black" />

                            <Label
                                Margin="20,10,0,0"
                                FontSize="10"
                                Text="Weekly Follow Up Question"
                                TextColor="Black" />

                            <Frame
                                Margin="10,0,10,0"
                                Padding="0"
                                BackgroundColor="White"
                                BorderColor="White"
                                CornerRadius="10"
                                HasShadow="False"
                                IsVisible="true">

                                <StackLayout BackgroundColor="Transparent" HeightRequest="40">
                                    <Label
                                        Margin="20,10,0,0"
                                        FontAttributes="Bold"
                                        HorizontalOptions="StartAndExpand"
                                        Text="Neither"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                </StackLayout>

                            </Frame>


                            <Label
                                Margin="20,10,0,0"
                                FontSize="10"
                                Text="Date Completed"
                                TextColor="Black" />

                            <Frame
                                Margin="10,0,10,0"
                                Padding="0"
                                BackgroundColor="White"
                                BorderColor="White"
                                CornerRadius="10"
                                HasShadow="False"
                                IsVisible="true">

                                <StackLayout BackgroundColor="Transparent" HeightRequest="40">
                                    <Label
                                        x:Name="neitherdate"
                                        Margin="20,10,0,0"
                                        FontAttributes="Bold"
                                        HorizontalOptions="StartAndExpand"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                </StackLayout>

                            </Frame>


                            <Label
                                Margin="0,20,0,0"
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="Center"
                                Text="Thank you for taking part in the IID3 Study"
                                TextColor="Black" />


                        </StackLayout>



                        <StackLayout x:Name="liststack" IsVisible="false">

                            <Image
                                Margin="0,20,0,5"
                                HeightRequest="50"
                                HorizontalOptions="CenterAndExpand"
                                Source="questionnaireicon.png"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="50" />


                            <Label
                                x:Name="titlelbl"
                                Margin="20,0,20,0"
                                FontAttributes="Bold"
                                FontSize="22"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                TextColor="Black" />

                            <Label
                                x:Name="infolbl"
                                Margin="20,-5,20,0"
                                FontAttributes="Bold"
                                FontSize="Small"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                TextColor="Gray" />


                            <Label
                                x:Name="incidentlbl"
                                Margin="20,10,0,0"
                                FontSize="10"
                                IsVisible="false"
                                Text="Weekly Follow Up Question"
                                TextColor="Black" />

                            <Frame
                                x:Name="incidentframe"
                                Margin="10,0,10,0"
                                Padding="0"
                                BackgroundColor="White"
                                BorderColor="White"
                                CornerRadius="10"
                                HasShadow="False"
                                IsVisible="false">

                                <StackLayout BackgroundColor="Transparent" HeightRequest="40">
                                    <Label
                                        x:Name="incidenttextlbl"
                                        Margin="20,10,0,0"
                                        FontAttributes="Bold"
                                        HorizontalOptions="StartAndExpand"
                                        TextColor="Black"
                                        VerticalOptions="Center" />
                                </StackLayout>

                            </Frame>





                            <!--<Label Text="Get started below" Margin="20,0,0,0" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#0F9FE2" FontSize="16" />-->

                            <syncfusion:SfListView
                                x:Name="questionnairelist"
                                Margin="5,20,5,0"
                                Padding="0"
                                AutoFitMode="DynamicHeight"
                                BackgroundColor="Transparent"
                                CachingStrategy="RecycleTemplate"
                                GroupHeaderSize="20"
                                HorizontalOptions="Center"
                                IsScrollingEnabled="False"
                                ItemsSourceChangeCachingStrategy="RecycleItems"
                                ScrollBarVisibility="Never"
                                SelectionBackground="Transparent"
                                VerticalOptions="StartAndExpand">
                                <syncfusion:SfListView.DataSource>
                                    <data:DataSource>
                                        <data:DataSource.GroupDescriptors>
                                            <data:GroupDescriptor PropertyName="QuestionName" />
                                        </data:DataSource.GroupDescriptors>
                                    </data:DataSource>
                                </syncfusion:SfListView.DataSource>
                                <syncfusion:SfListView.GroupHeaderTemplate>
                                    <DataTemplate>
                                        <ViewCell>


                                            <Frame
                                                Margin="5,0,5,0"
                                                Padding="0"
                                                BackgroundColor="White"
                                                BorderColor="White"
                                                CornerRadius="5"
                                                HasShadow="False">

                                                <StackLayout
                                                    Margin="10,0,10,0"
                                                    BackgroundColor="Transparent"
                                                    HorizontalOptions="FillAndExpand"
                                                    VerticalOptions="FillAndExpand">

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />


                                                        </Grid.RowDefinitions>

                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="10*" />
                                                            <ColumnDefinition Width="55*" />
                                                            <ColumnDefinition Width="20*" />
                                                            <ColumnDefinition Width="15*" />


                                                        </Grid.ColumnDefinitions>

                                                        <Label
                                                            Grid.Row="0"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="4"
                                                            Margin="5,0,0,0"
                                                            FontAttributes="Bold"
                                                            FontSize="14"
                                                            HorizontalOptions="Start"
                                                            LineHeight="1.4"
                                                            Text="{Binding Key}"
                                                            TextColor="Black"
                                                            VerticalOptions="Start" />

                                                        <!--<BoxView HeightRequest="1" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Color="Gray"/>-->
                                                    </Grid>
                                                </StackLayout>
                                            </Frame>
                                        </ViewCell>
                                    </DataTemplate>
                                </syncfusion:SfListView.GroupHeaderTemplate>
                                <syncfusion:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <ViewCell>



                                            <Border
                                                Margin="{Binding BottomMarginNum}"
                                                Padding="0"
                                                BackgroundColor="{Binding Backgroundcolourchange}"
                                                Stroke="{Binding Backgroundcolourchange}">

                                                <StackLayout Margin="10,0,10,10">
                                                    <Label
                                                        Grid.Row="1"
                                                        Grid.Column="0"
                                                        Grid.ColumnSpan="4"
                                                        Margin="10,0,0,5"
                                                        FontAttributes="Bold"
                                                        FontSize="12"
                                                        HorizontalOptions="Start"
                                                        Text="{Binding Directions}"
                                                        TextColor="Gray"
                                                        VerticalOptions="Start" />




