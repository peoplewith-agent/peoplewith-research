                                                            Orientation="Horizontal"
                                                            ScrollBarVisibility="Never"
                                                            SelectionBackground="Transparent"
                                                            SelectionMode="Single"
                                                            VerticalOptions="StartAndExpand">
                                                            <!--<syncfusion:SfListView.HeightRequest>
                                                <OnPlatform x:TypeArguments="x:Double" Android="300" iOS="300"/>
                                              </syncfusion:SfListView.HeightRequest>-->

                                                            <syncfusion:SfListView.ItemTemplate>
                                                                <DataTemplate>
                                                                    <ViewCell>
                                                                        <Border
                                                                            Margin="10,5,10,5"
                                                                            Padding="10"
                                                                            BackgroundColor="Transparent"
                                                                            Stroke="LightGray"
                                                                            StrokeShape="RoundRectangle 10">
                                                                            <Grid HorizontalOptions="FillAndExpand">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>



                                                                                <Label
                                                                                    Grid.Row="0"
                                                                                    Margin="0,-5,0,0"
                                                                                    FontAttributes="None"
                                                                                    FontSize="10"
                                                                                    HorizontalOptions="Center"
                                                                                    Text="{Binding Datemonth}"
                                                                                    TextColor="Black"
                                                                                    VerticalOptions="Start" />

                                                                                <Label
                                                                                    Grid.Row="1"
                                                                                    Margin="0,-5,0,0"
                                                                                    FontAttributes="None"
                                                                                    FontSize="18"
                                                                                    HorizontalOptions="Center"
                                                                                    Text="{Binding Dateday}"
                                                                                    TextColor="Black"
                                                                                    VerticalOptions="Start" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </ViewCell>
                                                                </DataTemplate>
                                                            </syncfusion:SfListView.ItemTemplate>
                                                            <syncfusion:SfListView.SelectedItemTemplate>
                                                                <DataTemplate>
                                                                    <ViewCell>
                                                                        <Border
                                                                            Margin="10,5,10,5"
                                                                            Padding="10"
                                                                            BackgroundColor="#ccebf9"
                                                                            Stroke="#009fe3"
                                                                            StrokeShape="RoundRectangle 10">
                                                                            <Grid HorizontalOptions="FillAndExpand">
                                                                                <Grid.RowDefinitions>
                                                                                    <RowDefinition Height="Auto" />
                                                                                    <RowDefinition Height="Auto" />
                                                                                </Grid.RowDefinitions>



                                                                                <Label
                                                                                    Grid.Row="0"
                                                                                    Margin="0,-5,0,0"
                                                                                    FontAttributes="Bold"
                                                                                    FontSize="10"
                                                                                    HorizontalOptions="Center"
                                                                                    Text="{Binding Datemonth}"
                                                                                    TextColor="Black"
                                                                                    VerticalOptions="Start" />

                                                                                <Label
                                                                                    Grid.Row="1"
                                                                                    Margin="0,-5,0,0"
                                                                                    FontAttributes="Bold"
                                                                                    FontSize="18"
                                                                                    HorizontalOptions="Center"
                                                                                    Text="{Binding Dateday}"
                                                                                    TextColor="Black"
                                                                                    VerticalOptions="Start" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </ViewCell>
                                                                </DataTemplate>
                                                            </syncfusion:SfListView.SelectedItemTemplate>
                                                        </local:ExtendedSFListview>



                                                        <Label
                                                            Margin="10,10,0,0"
                                                            FontAttributes="Bold"
                                                            FontSize="14"
                                                            HorizontalOptions="Start"
                                                            IsVisible="{Binding AddVisible2}"
                                                            Text="{Binding Addquestion2}"
                                                            TextColor="Black"
                                                            VerticalOptions="Start" />

                                                        <local:ExtendedEntry
                                                            Margin="10,0,10,0"
                                                            BackgroundColor="#EFF0F7"
                                                            Completed="ExtendedEntry_Completed"
                                                            IDValue="{Binding Id}"
                                                            IsVisible="{Binding AddVisible2}"
                                                            Keyboard="Text"
                                                            Placeholder="Enter Countries"
                                                            Text="{Binding Aqentry}"
                                                            TextChanged="ExtendedEntry_TextChanged_1"
                                                            TextColor="Black" />





                                                    </StackLayout>

                                                    <StackLayout IsVisible="{Binding TypeSSNumeric}">


                                                        <syncfusion1:SfRadioGroup HorizontalOptions="CenterAndExpand" Orientation="Horizontal">
                                                            <local:ExtendedRadioButton
                                                                Margin="0,0,5,0"
                                                                CheckedColor="#0F9FE2"
                                                                FontSize="12"
                                                                IDValue="{Binding Id}"
                                                                IsChecked="{Binding Ischecked0}"
                                                                StateChanged="ExtendedRadioButton_StateChanged"
                                                                Text="{Binding Value0}"
                                                                TextColor="Gray" />
                                                            <local:ExtendedRadioButton
                                                                Margin="0,0,5,0"
                                                                CheckedColor="#0F9FE2"
                                                                FontSize="12"
                                                                IDValue="{Binding Id}"
                                                                IsChecked="{Binding Ischecked1}"
                                                                StateChanged="SfRadioButton_StateChanged1"
                                                                Text="{Binding Value1}"
                                                                TextColor="Gray" />
                                                            <local:ExtendedRadioButton
                                                                Margin="0,0,5,0"
                                                                CheckedColor="#0F9FE2"
                                                                FontSize="12"
                                                                IDValue="{Binding Id}"
                                                                IsChecked="{Binding Ischecked2}"
                                                                StateChanged="SfRadioButton_StateChanged2"
                                                                Text="{Binding Value2}"
                                                                TextColor="Gray" />
                                                        </syncfusion1:SfRadioGroup>



                                                        <Label
                                                            Margin="10,10,0,0"
                                                            FontAttributes="Bold"
                                                            FontSize="14"
                                                            HorizontalOptions="Start"
                                                            IsVisible="{Binding AddVisible}"
                                                            Text="{Binding Addquestion}"
                                                            TextColor="Black"
                                                            VerticalOptions="Start" />


                                                        <local:ExtendedEntry
                                                            Margin="10,0,10,0"
                                                            BackgroundColor="#EFF0F7"
                                                            Completed="ExtendedEntry_Completed"
                                                            IDValue="{Binding Id}"
                                                            IsVisible="{Binding AddVisible}"
                                                            Keyboard="Numeric"
                                                            Placeholder="Enter Days"
                                                            Text="{Binding Aqentry}"
                                                            TextColor="Black" />





                                                    </StackLayout>



                                                    <!--  Type Header Info  -->
                                                    <StackLayout IsVisible="{Binding Headerinfo}">

                                                        <Label
                                                            Margin="10,0,10,0"
                                                            FontAttributes="Bold"
                                                            FontSize="14"
                                                            Text="{Binding Headertext}"
                                                            TextColor="Black" />

                                                        <BoxView
                                                            Margin="10,0,10,0"
                                                            HeightRequest="2"
                                                            HorizontalOptions="FillAndExpand"
                                                            Color="#009fe3" />

                                                    </StackLayout>

                                                    <!--<BoxView HeightRequest="2" Color="LightGray" Margin="50,30,50,30" />-->


                                                </StackLayout>
                                            </Border>
                                        </ViewCell>
                                    </DataTemplate>
                                </syncfusion:SfListView.ItemTemplate>


                            </syncfusion:SfListView>

                            <Button
                                x:Name="savebutton"
                                Margin="20,20,20,20"
                                BackgroundColor="#0F9FE2"
                                Clicked="Button_Clicked_1"
                                FontAttributes="Bold"
                                Text="Submit"
                                TextColor="White" />




                        </StackLayout>


                        <StackLayout
                            x:Name="successstack"
                            BackgroundColor="White"
                            IsVisible="false"
                            VerticalOptions="FillAndExpand">


                            <Image
                                Margin="0,0,0,0"
                                BackgroundColor="White"
                                HorizontalOptions="FillAndExpand"
                                Source="confettiebackground.png"
                                VerticalOptions="StartAndExpand" />

                            <Image
                                x:Name="completeimg"
                                Margin="0,30,0,0"
                                HeightRequest="100"
                                HorizontalOptions="CenterAndExpand"
                                VerticalOptions="CenterAndExpand"
                                WidthRequest="100" />
                            <Label
                                x:Name="completetext"
                                Margin="0,0,0,0"
                                FontAttributes="Bold"
                                FontSize="22"
                                HorizontalOptions="Center"
                                TextColor="Black" />

                            <Label
                                Margin="20,0,20,0"
                                FontAttributes="None"
                                FontSize="14"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="If you have had a positive incident, your GP will review the report and invite you to collect a sample kit. You will receive a notification and email. If you have already sent a poo (stool) sample within the last 3 weeks (21 days) please do not send another sample. &#10;Thank you if you have already provided a sample. &#10;Thank you for taking part in the IID3 Study. "
                                TextColor="Black" />


                            <!--<Label Text="Questionnaire Complete"   HorizontalOptions="Center" Margin="0,0,0,0" TextColor="Black" FontSize="24" FontAttributes="Bold"></Label>-->


                            <BoxView
                                Margin="0,10,0,10"
                                HeightRequest="1"
                                HorizontalOptions="CenterAndExpand"
                                IsVisible="false"
                                Color="LightGray" />

                            <Label
                                x:Name="scorelbl"
                                Margin="0,0,0,0"
                                FontAttributes="None"
                                FontSize="18"
                                HorizontalOptions="Center"
                                IsVisible="false"
                                Text="Your Score"
                                TextColor="Black" />

                            <Button
                                x:Name="scorebtn"
                                BackgroundColor="Transparent"
                                BorderColor="#0F9FE2"
                                BorderWidth="2"
                                CornerRadius="35"
                                FontAttributes="Bold"
                                FontSize="26"
                                HeightRequest="70"
                                HorizontalOptions="Center"
                                IsVisible="false"
                                Text="18"
                                TextColor="Black"
                                WidthRequest="70" />

                            <BoxView
                                x:Name="scoreline"
                                Margin="0,10,0,10"
                                HeightRequest="1"
                                HorizontalOptions="CenterAndExpand"
                                IsVisible="false"
                                Color="LightGray" />


                            <Grid Margin="0,20,0,0" IsVisible="false">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70*" />
                                    <ColumnDefinition Width="30*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,0,20"
                                    FontAttributes="None"
                                    FontSize="18"
                                    HorizontalOptions="End"
                                    Text="Completed Questions"
                                    TextColor="Black" />

                                <Label
                                    x:Name="completedquestioncount"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="0,0,0,0"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Start"
                                    TextColor="Black" />


                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Margin="0,20,0,20"
                                    FontAttributes="None"
                                    FontSize="18"
                                    HorizontalOptions="End"
                                    Text="Missed Questions"
                                    TextColor="Black" />

                                <Label
                                    x:Name="notcompletedquestioncount"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="0,20,0,0"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Start"
                                    TextColor="Black" />


                            </Grid>


                            <Button
                                Margin="20,50,20,0"
                                BackgroundColor="#0F9FE2"
                                Clicked="Button_Clicked"
                                FontAttributes="Bold"
                                Text="Got it!"
                                TextColor="White"
                                VerticalOptions="End" />


                        </StackLayout>
                    </StackLayout>
                </ScrollView>
            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>