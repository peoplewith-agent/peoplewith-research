<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.AllQuestionnaires"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    BackgroundColor="#F1F2F6">
    <ContentPage.Content>
        <ScrollView>
            <StackLayout>

                <Label
                    Margin="20,10,0,0"
                    FontAttributes="Bold"
                    FontSize="32"
                    HorizontalOptions="Start"
                    Text="My Progress"
                    TextColor="Black" />


                <syncfusion:SfListView
                    x:Name="previousquestionnairelist"
                    Margin="10,10,10,10"
                    AutoFitMode="Height"
                    ItemSize="70"
                    ItemTapped="previousquestionnairelist_ItemTapped"
                    SelectionBackground="Transparent"
                    SelectionMode="Single">
                    <syncfusion:SfListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Frame
                                    Margin="0,5,0,5"
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="White"
                                    CornerRadius="10"
                                    HasShadow="False">
                                    <StackLayout BackgroundColor="Transparent">
                                        <Grid Margin="0,10,0,10" RowSpacing="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80*" />
                                                <ColumnDefinition Width="15*" />
                                                <ColumnDefinition Width="5*" />


                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Label
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="1"
                                                Margin="10,0,0,0"
                                                FontAttributes="Bold"
                                                FontSize="16"
                                                Text="{Binding Weeknumber}"
                                                TextColor="Black"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                            <Label
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Grid.ColumnSpan="2"
                                                Margin="10,0,0,10"
                                                FontAttributes="None"
                                                FontSize="12"
                                                Text="{Binding Completestring}"
                                                TextColor="Gray"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                            <Image
                                                Grid.Row="0"
                                                Grid.RowSpan="2"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="1"
                                                Margin="0,0,0,0"
                                                HeightRequest="40"
                                                Source="{Binding Imagename}"
                                                VerticalOptions="CenterAndExpand"
                                                WidthRequest="40" />
                                            <!--<Image Source="nextdarker.png" IsVisible="{Binding Imagevis}" Margin="0,0,0,10" Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand" />-->

                                        </Grid>

                                    </StackLayout>
                                </Frame>
                            </ViewCell>
                        </DataTemplate>
                    </syncfusion:SfListView.ItemTemplate>
                </syncfusion:SfListView>






            </StackLayout>

        </ScrollView>

    </ContentPage.Content>
</ContentPage>