                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="25*" />
                                                                <ColumnDefinition Width="25*" />
                                                                <ColumnDefinition Width="25*" />
                                                                <ColumnDefinition Width="25*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>


                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="1"
                                                                Margin="0,0,0,0"
                                                                FontAttributes="Bold"
                                                                FontSize="12"
                                                                HorizontalOptions="Center"
                                                                Text="{Binding Label0}"
                                                                TextColor="Black" />
