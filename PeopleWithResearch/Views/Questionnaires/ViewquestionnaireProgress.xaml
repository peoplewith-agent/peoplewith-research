                                                    <!--  Type Single Selection  -->
                                                    <StackLayout IsVisible="{Binding Typess}">

                                                        <FlexLayout
                                                            Margin="10,0,10,0"
                                                            AlignContent="Start"
                                                            AlignItems="Start"
                                                            Wrap="Wrap">
                                                            <syncfusion1:SfRadioGroup>
                                                                <local:ExtendedRadioButton
                                                                    Margin="0,0,5,0"
                                                                    CheckedColor="#0F9FE2"
