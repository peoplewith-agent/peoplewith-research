                                                                IDValue="{Binding Answerid}"
                                                                Stroke="{Binding Buttonborder}"
                                                                StrokeThickness="2"
                                                                Text="{Binding Value0}"
                                                                TextColor="Black"
                                                                WidthRequest="50" />


                                                            <Label
                                                                Grid.Row="0"
                                                                Grid.Column="1"
                                                                Grid.ColumnSpan="1"
                                                                Margin="0,0,0,0"
                                                                FontAttributes="Bold"
                                                                FontSize="12"
                                                                HorizontalOptions="Center"
                                                                Text="{Binding Label1}"
                                                                TextColor="Black" />
