                                                                BackgroundColor="{Binding Buttonbackground}"
                                                                CornerRadius="25"
                                                                FontAttributes="Bold"
                                                                FontSize="18"
                                                                HorizontalOptions="CenterAndExpand"
                                                                IDRecord="{Binding Id}"
                                                                IDValue="{Binding Answerid}"
                                                                Stroke="{Binding Buttonborder2}"
                                                                StrokeThickness="2"
