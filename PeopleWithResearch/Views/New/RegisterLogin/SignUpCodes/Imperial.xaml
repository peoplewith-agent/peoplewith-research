                    Color="White" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,2.5"
                    FontAttributes="Bold"
                    FontFamily="OpenSansRegular"
                    FontSize="10"
                    HorizontalOptions="Center"
                    Text="Privacy Policy"
                    TextColor="#031926" />


            </Grid>
