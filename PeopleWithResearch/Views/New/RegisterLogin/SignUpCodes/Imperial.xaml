                    FontFamily="OpenSansSemiBold"
                    HorizontalOptions="Fill"
                    Text="Next"
                    TextColor="White" />

                <ActivityIndicator
                    x:Name="nextbtnloader"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="20,0,20,10"
                    HeightRequest="25"
                    HorizontalOptions="End"
                    IsRunning="False"
