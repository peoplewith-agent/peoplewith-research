<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.Imperial"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:editors="clr-namespace:Syncfusion.Maui.Inputs;assembly=Syncfusion.Maui.Inputs"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:local="clr-namespace:PeopleWithResearch"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:segmentprogressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:signPad="clr-namespace:Syncfusion.Maui.SignaturePad;assembly=Syncfusion.Maui.SignaturePad"
    xmlns:sliders="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="White"
    HideSoftInputOnTapped="True"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Color x:Key="PrimaryBlue">#007AFF</Color>
        <Color x:Key="SystemGray">#D1D1D6</Color>
        <Color x:Key="DarkText">#1C1C1E</Color>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!--  Top Navigation Bar  -->
        <Grid
            Grid.Row="0"
            Margin="10,10,15,0"
            BackgroundColor="Transparent"
            VerticalOptions="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />

            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!--  60% for Back button  -->
                <ColumnDefinition Width="2*" />
                <!--  40% for Progress bar  -->
            </Grid.ColumnDefinitions>

            <!--  Back Button  -->
            <Border
                Grid.Column="0"
                Padding="5"
                BackgroundColor="Transparent"
                HorizontalOptions="Start"
                Stroke="Transparent"
                StrokeShape="RoundRectangle 8"
                VerticalOptions="Center">

                <HorizontalStackLayout
                    x:Name="backbuttonstack"
                    Spacing="4"
                    VerticalOptions="Center">
                    <!--  Back Icon  -->
                    <Image
                        Margin="0,0,-2,0"
                        Aspect="AspectFit"
                        HeightRequest="12"
                        Source="back.png"
                        VerticalOptions="Center"
                        WidthRequest="15" />

                    <!--  Back Label  -->
                    <Label
                        FontFamily="OpenSansSemiBold"
                        FontSize="18"
                        Text="Back"
                        TextColor="#009fe3"
                        VerticalOptions="Center" />

                    <!--  Tap Gesture  -->
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer x:Name="BackButtonTapped" Tapped="BackButtonTapped_Tapped" />
                    </HorizontalStackLayout.GestureRecognizers>
                </HorizontalStackLayout>
            </Border>

            <!--  Progress Bar (occupies last 40%)  -->

            <progressBar:SfLinearProgressBar
                x:Name="topprogress"
                Grid.Column="1"
                Margin="10,0,10,0"
                AnimationEasing="{x:Static Easing.CubicInOut}"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                Minimum="0"
                Progress="0"
                ProgressCornerRadius="4"
                ProgressFill="#031926"
                ProgressHeight="8"
                SecondaryProgressFill="#BFDBF7"
                SegmentGapWidth="4"
                TrackCornerRadius="4"
                TrackFill="#BFDBF7"
                TrackHeight="9"
                VerticalOptions="Center" />

            <progressBar:SfLinearProgressBar
                x:Name="topprogress2"
                Grid.Row="1"
                Grid.Column="1"
                Grid.ColumnSpan="1"
                Margin="20,0,20,0"
                AnimationEasing="{x:Static Easing.CubicInOut}"
                BackgroundColor="Transparent"
                HorizontalOptions="Center"
                IsVisible="False"
                ProgressCornerRadius="5"
                ProgressFill="#009fe3"
                ProgressHeight="6"
                SecondaryProgressFill="LightBlue"
                TrackCornerRadius="5"
                TrackFill="#ccebf9"
                TrackHeight="6"
                VerticalOptions="Center" />

            <Border
                x:Name="bannerinfo"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="-10,0,-15,0"
                Padding="5"
                BackgroundColor="#009fe3"
                IsVisible="False"
                Stroke="Transparent">

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="8"
                    VerticalOptions="Center">



                    <Label
                        x:Name="bannerTextLbl"
                        FontAttributes="Bold"
                        FontFamily="OpenSansBold"
                        FontSize="12"
                        HorizontalTextAlignment="Center"
                        TextColor="White"
                        VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

        </Grid>





        <!--  Content Area with Large iOS Title  -->
        <ScrollView
            x:Name="mainscrollview"
            Grid.Row="1"
            Padding="30,0,30,0"
            BackgroundColor="White"
            VerticalOptions="Fill"
            VerticalScrollBarVisibility="Never">
            <Grid>

                <StackLayout x:Name="welcomestack" IsVisible="False">


                    <Label
                        x:Name="welcometoplbl"
                        Margin="0,20,0,0"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemiBold"
                        FontSize="26"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="#031926" />

                    <Image
                        x:Name="logoimg"
                        Margin="0,20,0,0"
                        BackgroundColor="Transparent"
                        HeightRequest="100"
                        HorizontalOptions="Center"
                        IsVisible="True"
                        Source="hopperlogo.png"
                        VerticalOptions="Start"
                        WidthRequest="200" />


                    <Label
                        x:Name="studytitlelbl"
                        Margin="0,10,0,0"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemiBold"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="#031926" />




                    <Label
                        x:Name="welcomesublbl"
                        Margin="0,10,0,0"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        TextColor="#777777" />


                    <Label
                        Margin="0,10,0,100"
                        FontFamily="OpenSansRegular"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="Empty"
                        TextColor="Transparent" />


                </StackLayout>

                <StackLayout x:Name="registerstack" IsVisible="False">

                    <Label
                        x:Name="toplbl"
                        Margin="0,20,0,0"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemiBold"
                        FontSize="26"
                        HorizontalOptions="Start"
                        HorizontalTextAlignment="Start"
                        LineBreakMode="WordWrap"
                        TextColor="#031926" />


                    <Label
                        x:Name="sublbl"
                        Margin="0,5,0,0"
                        FontFamily="OpenSansSemiBold"
                        FontSize="14"
                        HorizontalOptions="Start"
                        HorizontalTextAlignment="Start"
                        LineBreakMode="WordWrap"
                        TextColor="#777777" />

                    <Label
                        x:Name="infomainlbl"
                        Margin="0,10,10,0"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemiBold"
                        FontSize="12"
                        HorizontalOptions="Start"
                        IsVisible="False"
                        TextColor="#009fe3"
                        TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <StackLayout
                        x:Name="namestack"
                        Margin="0,10,0,100"
                        BackgroundColor="Transparent"
                        IsVisible="False">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50*" />
                                <ColumnDefinition Width="50*" />
                            </Grid.ColumnDefinitions>


                            <Label
                                Margin="0,20,0,0"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="15"
                                HorizontalOptions="Start"
                                IsVisible="False"
                                Text="First Name"
                                TextColor="#031926" />

                            <inputLayout:SfTextInputLayout
                                x:Name="fnhelper"
                                Grid.Row="0"
                                Grid.Column="0"
                                Margin="0,0,10,0"
                                BackgroundColor="Transparent"
                                ContainerBackground="Transparent"
                                ContainerType="None"
                                InputViewPadding="10"
                                IsHintAlwaysFloated="True"
                                OutlineCornerRadius="5"
                                ShowHint="False"
                                Stroke="LightGray"
                                UnfocusedStrokeThickness="1">
                                <Entry
                                    x:Name="firstnameentry"
                                    FontFamily="OpenSansRegular"
                                    FontSize="14"
                                    IsTextPredictionEnabled="False"
                                    Keyboard="Text"
                                    Placeholder="First Name"
                                    PlaceholderColor="Gray"
                                    TextChanged="firstnameentry_TextChanged"
                                    TextColor="#031926"
                                    VerticalOptions="Center" />
                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="10"
                                        TextColor="Red" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            </inputLayout:SfTextInputLayout>


                            <Label
                                Margin="0,20,0,0"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="15"
                                HorizontalOptions="Start"
                                IsVisible="False"
                                Text="Last Name"
                                TextColor="#031926" />

                            <inputLayout:SfTextInputLayout
                                x:Name="snhelper"
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                BackgroundColor="Transparent"
                                ContainerBackground="Transparent"
                                ContainerType="None"
                                InputViewPadding="10"
                                IsHintAlwaysFloated="True"
                                OutlineCornerRadius="5"
                                ShowHint="False"
                                Stroke="LightGray"
                                UnfocusedStrokeThickness="1">
                                <Entry
                                    x:Name="surnameentry"
                                    FontFamily="OpenSansRegular"
                                    FontSize="14"
                                    IsTextPredictionEnabled="False"
                                    Keyboard="Text"
                                    Placeholder="Surname"
                                    PlaceholderColor="Gray"
                                    TextChanged="surnameentry_TextChanged"
                                    TextColor="#031926"
                                    VerticalOptions="Center" />
                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="10"
                                        TextColor="Red" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            </inputLayout:SfTextInputLayout>


                            <!--<inputLayout:SfTextInputLayout InputViewPadding="10" Hint="Email address" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" x:Name="telhelper" IsHintAlwaysFloated="True" BackgroundColor="Transparent" ShowHint="False" Margin="0,0,10,0" UnfocusedStrokeThickness="1" Stroke="LightGray" ContainerBackground="Transparent" ContainerType="None" OutlineCornerRadius="5" >
                                <Entry FontSize="14" PlaceholderColor="Gray" x:Name="telentry" IsTextPredictionEnabled="False" Keyboard="Numeric" FontFamily="OpenSansRegular" VerticalOptions="Center" Placeholder="Telephone Number" TextColor="#031926"/>
                                <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                    <inputLayout:LabelStyle TextColor="Red"  FontSize="10"  FontFamily="OpenSansSemiBold" />
                                </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                            </inputLayout:SfTextInputLayout>-->



                        </Grid>


                        <inputLayout:SfTextInputLayout
                            x:Name="telhelper"
                            Margin="0,0,0,0"
                            BackgroundColor="Transparent"
                            ContainerBackground="Transparent"
                            ContainerType="None"
                            Hint="Telephone Number"
                            InputViewPadding="10"
                            IsHintAlwaysFloated="True"
                            OutlineCornerRadius="5"
                            ShowHint="False"
                            Stroke="LightGray">
                            <Entry
                                x:Name="telentry"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                Keyboard="Telephone"
                                Placeholder="Telephone Number"
                                PlaceholderColor="Gray"
                                TextChanged="telentry_TextChanged"
                                TextColor="#031926"
                                VerticalOptions="Center" />
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="12"
                                    TextColor="#031926" />
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="10"
                                    TextColor="Red" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        </inputLayout:SfTextInputLayout>

                        <inputLayout:SfTextInputLayout
                            x:Name="emailhelper"
                            Margin="0,0,0,0"
                            BackgroundColor="Transparent"
                            ContainerBackground="Transparent"
                            ContainerType="None"
                            Hint="Email Address"
