                                TextColor="#031926"
                                VerticalOptions="Center" />
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="12"
                                    TextColor="#031926" />
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="10"
                                    TextColor="Red" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        </inputLayout:SfTextInputLayout>

                        <inputLayout:SfTextInputLayout
                            x:Name="passhelper"
                            Margin="0,0,0,0"
                            BackgroundColor="Transparent"
                            ContainerBackground="Transparent"
                            ContainerType="None"
                            EnablePasswordVisibilityToggle="True"
                            InputViewPadding="10"
                            IsHintAlwaysFloated="True"
                            OutlineCornerRadius="5"
                            ShowHint="True"
                            Stroke="LightGray">
                            <Entry
                                x:Name="firstpasswordentry"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                Placeholder="Password"
                                PlaceholderColor="Gray"
                                TextChanged="firstpasswordentry_TextChanged"
                                TextColor="#031926"
                                VerticalOptions="Center" />
                            <inputLayout:SfTextInputLayout.HintLabelStyle>
                                <inputLayout:LabelStyle
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="12"
                                    TextColor="#031926" />
                            </inputLayout:SfTextInputLayout.HintLabelStyle>
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="10"
                                    TextColor="Red" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        </inputLayout:SfTextInputLayout>

                        <Label
                            x:Name="passlbl"
                            Margin="0,0,0,10"
                            FontAttributes="Bold"
                            FontFamily="OpenSansRegular"
                            FontSize="12"
                            HorizontalOptions="Start"
                            Text="Password must contain:"
                            TextColor="#777777"
                            VerticalOptions="Center" />

                        <Grid x:Name="passgrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="40*" />
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="40*" />
                            </Grid.ColumnDefinitions>

                            <Image
                                x:Name="chartick"
                                Grid.Row="0"
                                Grid.Column="0"
                                HeightRequest="20"
                                HorizontalOptions="Center"
                                Opacity="0.2"
                                Source="regtick.png"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="charlbl"
                                Grid.Row="0"
                                Grid.Column="1"
                                FontFamily="OpenSansRegular"
                                FontSize="12"
                                HorizontalOptions="Start"
                                Opacity="0.2"
                                Text="Min 8 Characters"
                                TextColor="#031926"
                                VerticalOptions="Center" />

                            <Image
                                x:Name="specialtick"
                                Grid.Row="0"
                                Grid.Column="2"
                                HeightRequest="20"
                                HorizontalOptions="Center"
                                Opacity="0.2"
                                Source="regtick.png"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="speciallbl"
                                Grid.Row="0"
                                Grid.Column="3"
                                FontFamily="OpenSansRegular"
                                FontSize="12"
                                HorizontalOptions="Start"
                                Opacity="0.2"
                                Text="Special Character"
                                TextColor="#031926"
                                VerticalOptions="Center" />


                            <Image
                                x:Name="capitaltick"
                                Grid.Row="1"
                                Grid.Column="0"
                                HeightRequest="20"
                                HorizontalOptions="Center"
                                Opacity="0.2"
                                Source="regtick.png"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="capitallbl"
                                Grid.Row="1"
                                Grid.Column="1"
                                FontFamily="OpenSansRegular"
                                FontSize="12"
                                HorizontalOptions="Start"
                                Opacity="0.2"
                                Text="Capital letter"
                                TextColor="#031926"
                                VerticalOptions="Center" />

                            <Image
                                x:Name="numtick"
                                Grid.Row="1"
                                Grid.Column="2"
                                HeightRequest="20"
                                HorizontalOptions="Center"
                                Opacity="0.2"
                                Source="regtick.png"
                                VerticalOptions="Center" />
                            <Label
                                x:Name="numlbl"
                                Grid.Row="1"
                                Grid.Column="3"
                                FontFamily="OpenSansRegular"
                                FontSize="12"
                                HorizontalOptions="Start"
                                Opacity="0.2"
                                Text="Number"
                                TextColor="#031926"
                                VerticalOptions="Center" />

                        </Grid>




                        <inputLayout:SfTextInputLayout
                            x:Name="confirmpasshelper"
                            Margin="0,0,0,0"
                            BackgroundColor="Transparent"
                            ContainerBackground="Transparent"
                            ContainerType="None"
                            EnablePasswordVisibilityToggle="True"
                            InputViewPadding="10"
                            IsHintAlwaysFloated="True"
                            OutlineCornerRadius="5"
                            ShowHint="True"
                            Stroke="LightGray">
                            <Entry
                                x:Name="confirmpassentry"
                                FontFamily="OpenSansRegular"
                                FontSize="14"
                                Placeholder="Confirm Password"
                                PlaceholderColor="Gray"
                                TextChanged="confirmpassentry_TextChanged"
                                TextColor="#031926"
                                VerticalOptions="Center" />
                            <inputLayout:SfTextInputLayout.ErrorLabelStyle>
                                <inputLayout:LabelStyle
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="10"
                                    TextColor="Red" />
                            </inputLayout:SfTextInputLayout.ErrorLabelStyle>
                        </inputLayout:SfTextInputLayout>








