<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.NewImperial"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    ios:Page.UseSafeArea="True"
    BackgroundColor="White"
    HideSoftInputOnTapped="True"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!--  Progress bar  -->
        <progressBar:SfLinearProgressBar
            Grid.Row="0"
            HeightRequest="6"
            Maximum="100"
            Minimum="0"
            Progress="{Binding ProgressAmount}"
            ProgressFill="#009fe3"
            TrackFill="#E5E7EB" />

        <!--  Step title  -->
        <StackLayout Grid.Row="1" Padding="20,16,20,8" Spacing="4">
            <Label
                FontFamily="HankenGroteskBold"
                FontSize="26"
                Text="{Binding StepTitle}"
                TextColor="#031926" />
            <Label
                FontFamily="HankenGroteskRegular"
                FontSize="14"
                IsVisible="{Binding HelpTextVisible}"
                Text="{Binding StepHelpText}"
                TextColor="#666666" />
        </StackLayout>

        <!--  Step host — only 1 step ContentView in visual tree at a time  -->
        <ScrollView Grid.Row="2">
            <ContentView x:Name="StepHost" />
        </ScrollView>

        <!--  Navigation buttons  -->
        <Grid
            Grid.Row="3"
            Padding="20,12"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="White">
            <Button
                Grid.Column="0"
                BackgroundColor="Transparent"
                BorderColor="#E5E7EB"
                BorderWidth="1"
                Command="{Binding BackCommand}"
                CornerRadius="8"
                FontFamily="HankenGroteskBold"
                FontSize="14"
                HeightRequest="48"
                IsVisible="{Binding CanGoBack}"
                Text="Back"
                TextColor="#031926"
                WidthRequest="100" />
            <ActivityIndicator
                Grid.Column="1"
                HeightRequest="30"
                HorizontalOptions="Center"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#009fe3" />
            <Button
                Grid.Column="2"
                BackgroundColor="#009fe3"
                Command="{Binding NextCommand}"
                CornerRadius="8"
                FontFamily="HankenGroteskBold"
                FontSize="14"
                HeightRequest="48"
                IsEnabled="{Binding IsNotBusy}"
                Text="{Binding NextButtonText}"
                TextColor="White"
                WidthRequest="120" />
        </Grid>

    </Grid>
</ContentPage>


