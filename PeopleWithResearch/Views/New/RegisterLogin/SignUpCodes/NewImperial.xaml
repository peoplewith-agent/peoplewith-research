                            Margin="0,0,10,10"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="10"
                            HorizontalOptions="End"
                            IsVisible="{Binding WakeError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                            Text="{local:Localize Key=Common_SelectAnOption}"
                            TextColor="Red" />

                        <Label
                            Margin="0,20,0,0"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Text="{Binding NightsLabel}"
                            TextColor="#031926" />
                        <syncfusion:SfListView
                            Margin="0,10,0,0"
                            AutoFitMode="Height"
                            BackgroundColor="Transparent"
                            ItemTemplate="{StaticResource OptionItemTemplate}"
                            ItemsSource="{Binding NightsOptions}"
                            Orientation="Vertical"
                            ScrollBarVisibility="Never"
                            SelectedItem="{Binding SelectedNightsOption, Mode=TwoWay}"
                            SelectedItemTemplate="{StaticResource OptionSelectedItemTemplate}"
                            SelectionBackground="Transparent"
                            SelectionGesture="Tap"
                            SelectionMode="Single">
                            <syncfusion:SfListView.ItemsLayout>
                                <syncfusion:GridLayout SpanCount="3" />
                            </syncfusion:SfListView.ItemsLayout>
                        </syncfusion:SfListView>
                        <Label
                            Margin="0,0,10,10"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="10"
                            HorizontalOptions="End"
                            IsVisible="{Binding NightsError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                            Text="{local:Localize Key=Common_SelectAnOption}"
                            TextColor="Red" />

                        <Label
                            Margin="0,20,0,0"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Text="{Binding QualityLabel}"
                            TextColor="#031926" />
                        <syncfusion:SfListView
                            Margin="0,10,0,0"
                            AutoFitMode="Height"
                            BackgroundColor="Transparent"
                            ItemTemplate="{StaticResource OptionItemTemplate}"
                            ItemsSource="{Binding QualityOptions}"
                            Orientation="Vertical"
                            ScrollBarVisibility="Never"
                            SelectedItem="{Binding SelectedQualityOption, Mode=TwoWay}"
                            SelectedItemTemplate="{StaticResource OptionSelectedItemTemplate}"
                            SelectionBackground="Transparent"
                            SelectionGesture="Tap"
                            SelectionMode="Single">
                            <syncfusion:SfListView.ItemsLayout>
                                <syncfusion:GridLayout SpanCount="2" />
                            </syncfusion:SfListView.ItemsLayout>
                        </syncfusion:SfListView>
                        <Label
                            Margin="0,0,10,10"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="10"
                            HorizontalOptions="End"
                            IsVisible="{Binding QualityError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                            Text="{local:Localize Key=Common_SelectAnOption}"
                            TextColor="Red" />

                        <Label
                            Margin="0,20,0,0"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Text="{Binding MoodLabel}"
                            TextColor="#031926" />
                        <syncfusion:SfListView
                            Margin="0,10,0,0"
                            AutoFitMode="Height"
                            BackgroundColor="Transparent"
                            ItemTemplate="{StaticResource OptionItemTemplate}"
                            ItemsSource="{Binding MoodOptions}"
                            Orientation="Vertical"
                            ScrollBarVisibility="Never"
                            SelectedItem="{Binding SelectedMoodOption, Mode=TwoWay}"
                            SelectedItemTemplate="{StaticResource OptionSelectedItemTemplate}"
                            SelectionBackground="Transparent"
                            SelectionGesture="Tap"
                            SelectionMode="Single">
                            <syncfusion:SfListView.ItemsLayout>
                                <syncfusion:GridLayout SpanCount="2" />
                            </syncfusion:SfListView.ItemsLayout>
                        </syncfusion:SfListView>
                        <Label
                            Margin="0,0,10,10"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="10"
                            HorizontalOptions="End"
                            IsVisible="{Binding MoodError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                            Text="{local:Localize Key=Common_SelectAnOption}"
                            TextColor="Red" />

                        <Label
                            Margin="0,20,0,0"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Text="{Binding ProdLabel}"
                            TextColor="#031926" />
                        <syncfusion:SfListView
                            Margin="0,10,0,0"
                            AutoFitMode="Height"
                            BackgroundColor="Transparent"
                            ItemTemplate="{StaticResource OptionItemTemplate}"
                            ItemsSource="{Binding ProdOptions}"
                            Orientation="Vertical"
                            ScrollBarVisibility="Never"
                            SelectedItem="{Binding SelectedProdOption, Mode=TwoWay}"
                            SelectedItemTemplate="{StaticResource OptionSelectedItemTemplate}"
                            SelectionBackground="Transparent"
                            SelectionGesture="Tap"
                            SelectionMode="Single">
                            <syncfusion:SfListView.ItemsLayout>
                                <syncfusion:GridLayout SpanCount="2" />
                            </syncfusion:SfListView.ItemsLayout>
                        </syncfusion:SfListView>
                        <Label
                            Margin="0,0,10,10"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="10"
                            HorizontalOptions="End"
                            IsVisible="{Binding ProdError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                            Text="{local:Localize Key=Common_SelectAnOption}"
                            TextColor="Red" />

                        <Label
                            Margin="0,20,0,0"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Text="{Binding PoorSleepLabel}"
                            TextColor="#031926" />
                        <syncfusion:SfListView
                            Margin="0,10,0,0"
                            AutoFitMode="Height"
                            BackgroundColor="Transparent"
                            ItemTemplate="{StaticResource OptionItemTemplate}"
                            ItemsSource="{Binding PoorSleepOptions}"
                            Orientation="Vertical"
                            ScrollBarVisibility="Never"
                            SelectedItem="{Binding SelectedPoorSleepOption, Mode=TwoWay}"
                            SelectedItemTemplate="{StaticResource OptionSelectedItemTemplate}"
                            SelectionBackground="Transparent"
                            SelectionGesture="Tap"
                            SelectionMode="Single">
                            <syncfusion:SfListView.ItemsLayout>
                                <syncfusion:GridLayout SpanCount="2" />
                            </syncfusion:SfListView.ItemsLayout>
                        </syncfusion:SfListView>
                        <Label
                            Margin="0,0,10,10"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="10"
                            HorizontalOptions="End"
                            IsVisible="{Binding PoorSleepError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                            Text="{local:Localize Key=Common_SelectAnOption}"
                            TextColor="Red" />

                        <Label
                            Margin="0,20,0,0"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="15"
                            HorizontalOptions="Start"
                            Text="{Binding SleepProbLabel}"
                            TextColor="#031926" />
                        <syncfusion:SfListView
                            Margin="0,10,0,0"
                            AutoFitMode="Height"
                            BackgroundColor="Transparent"
                            ItemTemplate="{StaticResource OptionItemTemplate}"
                            ItemsSource="{Binding SleepProbOptions}"
                            Orientation="Vertical"
                            ScrollBarVisibility="Never"
                            SelectedItem="{Binding SelectedSleepProbOption, Mode=TwoWay}"
                            SelectedItemTemplate="{StaticResource OptionSelectedItemTemplate}"
                            SelectionBackground="Transparent"
                            SelectionGesture="Tap"
                            SelectionMode="Single">
                            <syncfusion:SfListView.ItemsLayout>
                                <syncfusion:GridLayout SpanCount="2" />
                            </syncfusion:SfListView.ItemsLayout>
                        </syncfusion:SfListView>
                        <Label
                            Margin="0,0,10,10"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="10"
                            HorizontalOptions="End"
                            IsVisible="{Binding SleepProbError, Converter={StaticResource StringNotEmptyToBoolConverter}}"
                            Text="{local:Localize Key=Common_SelectAnOption}"
                            TextColor="Red" />
                    </StackLayout>

                    <!--  ================= Terms & Consent =================  -->
                    <VerticalStackLayout Margin="0,10,0,100" IsVisible="{Binding IsTermsStackVisible}">

                        <Image
                            Margin="0,20,0,0"
                            HeightRequest="80"
                            HorizontalOptions="Center"
                            Source="agreement.png"
                            VerticalOptions="Center"
                            WidthRequest="80" />

                        <!--  Dynamic, server-driven consent sections. Each item's checkbox binds straight to its own ChckedState — no page-level property needed for the checkbox itself.  -->
                        <CollectionView
                            x:Name="MainConsentCollection"
                            Margin="0,0,0,10"
                            Background="Transparent"
                            CanReorderItems="False"
                            HeightRequest="{OnPlatform iOS='2250'}"
                            HorizontalScrollBarVisibility="Never"
                            ItemSizingStrategy="MeasureAllItems"
                            ItemsSource="{Binding AllConsentDetails.consentcontent}"
                            ItemsUpdatingScrollMode="KeepItemsInView"
                            SelectionMode="None"
                            VerticalOptions="Fill"
                            VerticalScrollBarVisibility="Never">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                                    ItemSpacing="0"
                                    Orientation="Vertical"
                                    SnapPointsType="None" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Padding="0">
                                        <Label
                                            Margin="0,20,0,10"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="16"
                                            Text="{Binding section}"
                                            TextColor="#031926" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding sectioncontent}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <VerticalStackLayout Spacing="2">
                                                        <Border
                                                            Margin="0,4"
                                                            Padding="10,4"
                                                            Background="Transparent"
                                                            StrokeThickness="1">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="8" />
                                                            </Border.StrokeShape>
                                                            <Border.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding HasError}"
                                                                    TargetType="Border"
                                                                    Value="True">
                                                                    <Setter Property="Stroke" Value="Red" />
                                                                </DataTrigger>
                                                                <DataTrigger
                                                                    Binding="{Binding HasError}"
                                                                    TargetType="Border"
                                                                    Value="False">
                                                                    <Setter Property="Stroke" Value="#D1E8FF" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleConsentItemCommand}" CommandParameter="{Binding .}" />
                                                            </Border.GestureRecognizers>
                                                            <Grid
                                                                Padding="0,8"
                                                                ColumnDefinitions="*, 9*"
                                                                ColumnSpacing="10"
                                                                RowDefinitions="Auto">
                                                                <CheckBox
                                                                    Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    InputTransparent="True"
                                                                    IsChecked="{Binding ChckedState, Mode=TwoWay}"
                                                                    VerticalOptions="Center"
                                                                    Color="#031926" />
                                                                <Label
                                                                    Grid.Row="0"
                                                                    Grid.Column="1"
                                                                    FontFamily="OpenSansRegular"
                                                                    FontSize="14"
                                                                    HorizontalOptions="Fill"
                                                                    InputTransparent="True"
                                                                    LineBreakMode="WordWrap"
                                                                    Text="{Binding consentitem}"
                                                                    TextColor="#031926"
                                                                    VerticalOptions="Center" />
                                                            </Grid>
                                                        </Border>
                                                        <Label
                                                            Margin="0,0,5,5"
                                                            FontAttributes="Bold"
                                                            FontFamily="OpenSansSemiBold"
                                                            FontSize="8"
                                                            HorizontalOptions="End"
                                                            Text="{Binding requiredlbl}"
                                                            TextColor="#009fe3">
                                                            <Label.Triggers>
                                                                <DataTrigger
                                                                    Binding="{Binding HasError}"
                                                                    TargetType="Label"
                                                                    Value="True">
                                                                    <Setter Property="TextColor" Value="Red" />
                                                                </DataTrigger>
                                                            </Label.Triggers>
                                                        </Label>
                                                    </VerticalStackLayout>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <StackLayout>
                            <Label
                                Margin="0,20,0,10"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="16"
                                Text="{local:Localize Key=Register_TermsTitle}"
                                TextColor="#031926" />

                            <Border
                                Margin="0,4"
                                Padding="10,4"
                                Background="Transparent"
                                Stroke="#D1E8FF"
                                StrokeThickness="1">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsTcError}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="Stroke" Value="Red" />
                                    </DataTrigger>
                                    <DataTrigger
                                        Binding="{Binding IsTcError}"
                                        TargetType="Border"
                                        Value="False">
                                        <Setter Property="Stroke" Value="#D1E8FF" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleTcCheckedCommand}" />
                                </Border.GestureRecognizers>
                                <Grid
                                    Padding="0,8"
                                    ColumnDefinitions="*, 9*"
                                    ColumnSpacing="10">
                                    <CheckBox
                                        Grid.Column="0"
                                        InputTransparent="True"
                                        IsChecked="{Binding IsTcChecked}"
                                        VerticalOptions="Center"
                                        Color="#031926" />
                                    <Label
                                        Grid.Column="1"
                                        FontSize="14"
                                        HorizontalOptions="Start"
                                        InputTransparent="True"
                                        LineBreakMode="WordWrap"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontFamily="OpenSansRegular"
                                                    FontSize="14"
                                                    Text="{local:Localize Key=Register_AgreeTerms}"
                                                    TextColor="#031926" />
                                                <Span
                                                    FontFamily="OpenSansRegular"
                                                    FontSize="14"
                                                    Text="{local:Localize Key=Register_AgreeTermsLink}"
                                                    TextColor="#031926" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Border>
                            <Label
                                Margin="0,0,5,5"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="8"
                                HorizontalOptions="End"
                                Text="{local:Localize Key=Register_Required}"
                                TextColor="#009fe3" />

                            <Border
                                Margin="0,10,0,20"
                                Padding="10,4"
                                BackgroundColor="Transparent"
                                Stroke="#D1E8FF"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleEmailOptInCommand}" />
                                </Border.GestureRecognizers>
                                <Grid
                                    Padding="0,8"
                                    ColumnDefinitions="*, 9*"
                                    ColumnSpacing="10">
                                    <CheckBox
                                        Grid.Column="0"
                                        InputTransparent="True"
                                        IsChecked="{Binding IsEmailOptInChecked}"
                                        VerticalOptions="Center"
                                        Color="#031926" />
                                    <Label
                                        Grid.Column="1"
                                        HorizontalOptions="Start"
                                        InputTransparent="True"
                                        LineBreakMode="WordWrap"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontFamily="OpenSansRegular"
                                                    FontSize="14"
                                                    Text="{local:Localize Key=Register_AgreeEmail}"
                                                    TextColor="#031926" />
                                                <Span
                                                    FontFamily="OpenSansRegular"
                                                    FontSize="14"
                                                    Text="{local:Localize Key=Register_AgreeEmailLink}"
                                                    TextColor="#031926" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                            </Border>
                        </StackLayout>

                        <!--  5-10 age tier only  -->
                        <StackLayout Margin="0,0,0,20" IsVisible="{Binding IsUnder10StackVisible}">
                            <Label
                                Margin="0,10,0,0"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="18"
                                HorizontalOptions="Start"
                                Text="{Binding Under10NameLabel}"
                                TextColor="#031926" />
                            <inputLayout:SfTextInputLayout
                                Margin="0,10,0,0"
                                ErrorText="{local:Localize Key=Register_EnterFullName}"
                                HasError="{Binding Under10NameError}">
                                <Entry
                                    FontFamily="OpenSansRegular"
                                    FontSize="14"
                                    IsTextPredictionEnabled="False"
                                    Placeholder="Name"
                                    PlaceholderColor="Gray"
                                    Text="{Binding Under10Name}"
                                    TextColor="#031926"
                                    VerticalOptions="Center" />
                            </inputLayout:SfTextInputLayout>

                            <Label
                                Margin="0,10,0,0"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="18"
                                HorizontalOptions="Start"
                                Text="{Binding Under10RoleLabel}"
                                TextColor="#031926" />
                            <syncfusion:SfListView
                                Margin="0,10,0,0"
                                AutoFitMode="Height"
                                BackgroundColor="Transparent"
                                ItemTemplate="{StaticResource SignoffOptionItemTemplate}"
                                ItemsSource="{Binding Under10RoleOptions}"
                                Orientation="Vertical"
                                ScrollBarVisibility="Never"
                                SelectedItem="{Binding SelectedUnder10RoleOption, Mode=TwoWay}"
                                SelectedItemTemplate="{StaticResource SignoffOptionSelectedItemTemplate}"
                                SelectionBackground="Transparent"
                                SelectionGesture="Tap"
                                SelectionMode="Single">
                                <syncfusion:SfListView.ItemsLayout>
                                    <syncfusion:GridLayout SpanCount="2" />
                                </syncfusion:SfListView.ItemsLayout>
                            </syncfusion:SfListView>
                            <Label
                                Margin="0,0,10,10"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="10"
                                HorizontalOptions="End"
                                IsVisible="{Binding Under10RoleError}"
                                Text="{local:Localize Key=Common_SelectAnOption}"
                                TextColor="Red" />

                            <inputLayout:SfTextInputLayout
                                Margin="0,10,0,0"
                                ErrorText="{local:Localize Key=Register_EnterRole}"
                                HasError="{Binding Under10OtherRoleError}"
                                IsVisible="{Binding IsUnder10OtherRoleVisible}">
                                <Entry
                                    FontFamily="OpenSansRegular"
                                    FontSize="14"
                                    IsTextPredictionEnabled="False"
                                    Placeholder="Other Role"
                                    PlaceholderColor="Gray"
                                    Text="{Binding Under10OtherRole}"
                                    TextColor="#031926"
                                    VerticalOptions="Center" />
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>

                        <StackLayout>
                            <Label
                                Margin="0,10,0,0"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="18"
                                HorizontalOptions="Start"
                                Text="{Binding Over16NameLabel}"
                                TextColor="#031926" />
                            <inputLayout:SfTextInputLayout
                                Margin="0,10,0,0"
                                ErrorText="{local:Localize Key=Register_EnterFullName}"
                                HasError="{Binding Over16NameError}">
                                <Entry
                                    FontFamily="OpenSansRegular"
                                    FontSize="14"
                                    IsTextPredictionEnabled="False"
                                    Placeholder="Name"
                                    PlaceholderColor="Gray"
                                    Text="{Binding Over16Name}"
                                    TextColor="#031926"
                                    VerticalOptions="Center" />
                            </inputLayout:SfTextInputLayout>
                        </StackLayout>

                        <Label
                            Margin="0,10,0,0"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="18"
                            HorizontalOptions="Start"
                            Text="{Binding Over16SignatureLabel}"
                            TextColor="#031926" />

                        <StackLayout Margin="0,0,0,50">
                            <Grid RowDefinitions="Auto,Auto,100">
                                <Label
                                    Grid.Row="0"
                                    Margin="0,10,0,10"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="14"
                                    HorizontalOptions="Start"
                                    TextColor="#031926">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span FontSize="12" TextColor="#475569">
                                                <Span.Text>
                                                    <OnPlatform x:TypeArguments="x:String">
                                                        <On Platform="iOS" Value="Press and hold briefly to begin signing" />
                                                        <On Platform="Android" Value="Please sign below" />
                                                    </OnPlatform>
                                                </Span.Text>
                                            </Span>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,0,0,20"
                                    Padding="2"
                                    HeightRequest="200"
                                    IsVisible="{OnPlatform iOS=true,
                                                           Android=false}"
                                    Stroke="#BFDBF7"
                                    StrokeShape="RoundRectangle 10">
                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsSignatureError}"
                                            TargetType="Border"
                                            Value="True">
                                            <Setter Property="Stroke" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsSignatureError}"
                                            TargetType="Border"
                                            Value="False">
                                            <Setter Property="Stroke" Value="#BFDBF7" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <toolkit:DrawingView
                                        x:Name="drawingpad"
                                        Grid.Row="1"
                                        BackgroundColor="White"
                                        DrawingLineCompleted="DrawingPad_DrawingLineCompleted"
                                        HeightRequest="200"
                                        IsMultiLineModeEnabled="True"
                                        LineColor="Black"
                                        LineWidth="2"
                                        ShouldClearOnFinish="False" />
                                </Border>

                                <Border
                                    Grid.Row="1"
                                    Margin="0,0,0,20"
                                    Padding="2"
                                    HeightRequest="200"
                                    IsVisible="{OnPlatform iOS=false,
                                                           Android=true}"
                                    Stroke="#BFDBF7"
                                    StrokeShape="RoundRectangle 10">
                                    <Border.Triggers>
                                        <DataTrigger
                                            Binding="{Binding IsSignatureError}"
                                            TargetType="Border"
                                            Value="True">
                                            <Setter Property="Stroke" Value="Red" />
                                        </DataTrigger>
                                        <DataTrigger
                                            Binding="{Binding IsSignatureError}"
                                            TargetType="Border"
                                            Value="False">
                                            <Setter Property="Stroke" Value="#BFDBF7" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <signPad:SfSignaturePad
                                        x:Name="signpad"
                                        Grid.Row="1"
                                        BackgroundColor="White"
                                        DrawCompleted="SignPad_DrawCompleted"
                                        HeightRequest="200"
                                        StrokeColor="Black"
                                        VerticalOptions="Fill" />
                                </Border>

                                <Button
                                    Grid.Row="1"
                                    BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    Command="{Binding ClearSignatureCommand}"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="End"
                                    Text="X"
                                    TextColor="#031926"
                                    VerticalOptions="Start" />
                            </Grid>
                        </StackLayout>
                    </VerticalStackLayout>

                    <!--  ================= Finish =================  -->
                    <StackLayout Margin="0,10,0,100" IsVisible="{Binding IsFinishStackVisible}">
                        <Image
                            HeightRequest="120"
                            HorizontalOptions="Center"
                            Source="finishtick.png"
                            VerticalOptions="Center"
                            WidthRequest="120" />
                        <Label
                            Margin="0,20,0,0"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="26"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{Binding FinishText}"
                            TextColor="#031926" />
                        <Label
                            Margin="0,20,0,0"
                            FontFamily="OpenSansRegular"
                            FontSize="16"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{Binding FinishSubText}"
                            TextColor="#031926" />
                    </StackLayout>
                </StackLayout>
            </Grid>
        </ScrollView>

        <!--  Bottom Action Bar  -->
        <StackLayout
            Grid.Row="2"
            BackgroundColor="White"
            HorizontalOptions="Fill"
            VerticalOptions="End">
            <Grid ColumnDefinitions="50*,50*" RowDefinitions="Auto,Auto,Auto">
                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="20,0,20,10"
                    BackgroundColor="#009fe3"
                    Command="{Binding NextCommand}"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemiBold"
                    FontSize="15"
                    HorizontalOptions="Fill"
                    IsEnabled="{Binding IsNextEnabled}"
                    Text="{Binding NextButtonText}"
                    TextColor="White" />

                <ActivityIndicator
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="20,0,20,10"
                    HeightRequest="25"
                    HorizontalOptions="End"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="White" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,10,0,2.5"
                    FontAttributes="Bold"
                    FontFamily="OpenSansRegular"
                    FontSize="10"
                    HorizontalOptions="Center"
                    Text="{local:Localize Key=Common_PrivacyPolicy}"
                    TextColor="#031926"
                    VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="TapGestureRecognizer_Tapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>
        </StackLayout>
    </Grid>
</ContentPage>
