<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PeopleWithResearch.TandCsStepView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid>
        <StackLayout Padding="20,10" Spacing="12">
            <Label
                FontFamily="HankenGroteskBold"
                FontSize="22"
                Text="Terms &amp; Conditions"
                TextColor="#031926" />
            <Label
                FontFamily="HankenGroteskRegular"
                FontSize="14"
                Text="Please review and sign below to agree to the study terms and conditions."
                TextColor="#031926" />
            <Border
                Padding="10"
                BackgroundColor="#F8F9FB"
                Stroke="#E5E7EB"
                StrokeShape="RoundRectangle 8">
                <ScrollView HeightRequest="200">
                    <Label
                        x:Name="tandcslbl"
                        FontFamily="HankenGroteskRegular"
                        FontSize="13"
                        Text="{Binding TandCsText}"
                        TextColor="#031926" />
                </ScrollView>
            </Border>
            <Label
                FontFamily="HankenGroteskBold"
                FontSize="14"
                Text="Please sign below:"
                TextColor="#031926" />
            <Border
                HeightRequest="200"
                BackgroundColor="White"
                Stroke="#E5E7EB"
                StrokeShape="RoundRectangle 8">
                <Label
                    HorizontalOptions="Center"
                    FontFamily="HankenGroteskRegular"
                    FontSize="13"
                    Text="Signature pad area"
                    TextColor="#AAAAAA"
                    VerticalOptions="Center" />
            </Border>
            <Label x:Name="tandcserrlbl" FontFamily="HankenGroteskRegular" FontSize="12" IsVisible="{Binding TandCsHasError}" Text="{Binding TandCsErrorMessage}" TextColor="Red" />
        </StackLayout>
    </Grid>
</ContentView>
