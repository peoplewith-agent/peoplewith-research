<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PeopleWithResearch.SleepStepView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView">
    <Grid>
        <StackLayout Padding="20,10" Spacing="12">
            <Label
                FontFamily="HankenGroteskBold"
                FontSize="22"
                Text="Sleep"
                TextColor="#031926" />
            <Label
                FontFamily="HankenGroteskRegular"
                FontSize="14"
                Text="How would you describe your typical sleep?"
                TextColor="#031926" />
            <syncfusion:SfListView
                x:Name="sleeplist"
                AutoFitMode="Height"
                IsScrollingEnabled="False"
                ItemsSource="{Binding SleepOptions}"
                ScrollBarVisibility="Never"
                SelectionMode="Single">
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10,8">
                            <Label FontFamily="HankenGroteskRegular" FontSize="14" Text="{Binding Title}" TextColor="#031926" />
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
            </syncfusion:SfListView>
            <Label x:Name="sleeperrlbl" FontFamily="HankenGroteskRegular" FontSize="12" IsVisible="{Binding SleepHasError}" Text="{Binding SleepErrorMessage}" TextColor="Red" />
        </StackLayout>
    </Grid>
</ContentView>
