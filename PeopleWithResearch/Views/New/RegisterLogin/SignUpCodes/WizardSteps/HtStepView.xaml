<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:sliders="clr-namespace:Syncfusion.Maui.Sliders;assembly=Syncfusion.Maui.Sliders"
    x:Class="PeopleWithResearch.Views.New.RegisterLogin.SignUpCodes.HtStepView">
    <Grid Padding="20,10,20,16">
        <VerticalStackLayout Spacing="0">

            <Label
                Text="{Binding StepTitle}"
                FontFamily="HankenGroteskBold"
                FontSize="18"
                TextColor="#031926"
                HorizontalOptions="Start"
                Margin="0,10,0,0" />

            <Label
                Text="{Binding StepSubtitle}"
                FontFamily="HankenGroteskRegular"
                FontSize="13"
                TextColor="#031926"
                HorizontalOptions="Start"
                LineBreakMode="WordWrap"
                Margin="0,10,0,0" />

            <!-- Mobility -->
            <syncfusion:SfListView
                x:Name="moblist"
                Margin="0,10,0,0"
                AutoFitMode="Height"
                BackgroundColor="Transparent"
                IsScrollingEnabled="False"
                Orientation="Vertical"
                ScrollBarVisibility="Never"
                SelectionBackground="Transparent"
                SelectionGesture="Tap"
                SelectionMode="Single"
                ItemsSource="{Binding MobilityOptions}"
                SelectedItem="{Binding SelectedMobilityOption, Mode=TwoWay}">
                <syncfusion:SfListView.ItemsLayout>
                    <syncfusion:GridLayout SpanCount="1" />
                </syncfusion:SfListView.ItemsLayout>
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="Transparent"
                                    Stroke="LightGray" StrokeShape="RoundRectangle 10">
                                <Label FontFamily="HankenGroteskRegular" FontSize="12"
                                       Text="{Binding Text}" TextColor="Gray"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
                <syncfusion:SfListView.SelectedItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="#d8e9fa"
                                    Stroke="#009fe3" StrokeShape="RoundRectangle 10" StrokeThickness="2">
                                <Label FontAttributes="Bold" FontFamily="HankenGroteskBold" FontSize="12"
                                       Text="{Binding Text}" TextColor="#031926"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.SelectedItemTemplate>
            </syncfusion:SfListView>

            <Label
                Text="{Binding HtStackErrorMessage}"
                IsVisible="{Binding HtStackError}"
                FontFamily="HankenGroteskBold"
                FontSize="10"
                TextColor="Red"
                HorizontalOptions="End"
                Margin="0,4,0,0" />

            <!-- Self-care -->
            <Label
                Text="{Binding SelfCareLabel}"
                FontFamily="HankenGroteskBold"
                FontSize="15"
                TextColor="#031926"
                HorizontalOptions="Start"
                Margin="0,10,0,0" />

            <syncfusion:SfListView
                x:Name="sclist"
                Margin="0,10,0,0"
                AutoFitMode="Height"
                BackgroundColor="Transparent"
                IsScrollingEnabled="False"
                Orientation="Vertical"
                ScrollBarVisibility="Never"
                SelectionBackground="Transparent"
                SelectionGesture="Tap"
                SelectionMode="Single"
                ItemsSource="{Binding SelfCareOptions}"
                SelectedItem="{Binding SelectedSelfCareOption, Mode=TwoWay}">
                <syncfusion:SfListView.ItemsLayout>
                    <syncfusion:GridLayout SpanCount="1" />
                </syncfusion:SfListView.ItemsLayout>
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="Transparent"
                                    Stroke="LightGray" StrokeShape="RoundRectangle 10">
                                <Label FontFamily="HankenGroteskRegular" FontSize="12"
                                       Text="{Binding Text}" TextColor="Gray"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
                <syncfusion:SfListView.SelectedItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="#d8e9fa"
                                    Stroke="#009fe3" StrokeShape="RoundRectangle 10" StrokeThickness="2">
                                <Label FontAttributes="Bold" FontFamily="HankenGroteskBold" FontSize="12"
                                       Text="{Binding Text}" TextColor="#031926"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.SelectedItemTemplate>
            </syncfusion:SfListView>

            <!-- Usual activities -->
            <Label
                Text="{Binding UsualActivitiesLabel}"
                FontFamily="HankenGroteskBold"
                FontSize="15"
                TextColor="#031926"
                HorizontalOptions="Start"
                Margin="0,10,0,0" />

            <syncfusion:SfListView
                x:Name="uclist"
                Margin="0,10,0,0"
                AutoFitMode="Height"
                BackgroundColor="Transparent"
                IsScrollingEnabled="False"
                Orientation="Vertical"
                ScrollBarVisibility="Never"
                SelectionBackground="Transparent"
                SelectionGesture="Tap"
                SelectionMode="Single"
                ItemsSource="{Binding UsualActivitiesOptions}"
                SelectedItem="{Binding SelectedUsualActivitiesOption, Mode=TwoWay}">
                <syncfusion:SfListView.ItemsLayout>
                    <syncfusion:GridLayout SpanCount="1" />
                </syncfusion:SfListView.ItemsLayout>
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="Transparent"
                                    Stroke="LightGray" StrokeShape="RoundRectangle 10">
                                <Label FontFamily="HankenGroteskRegular" FontSize="12"
                                       Text="{Binding Text}" TextColor="Gray"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
                <syncfusion:SfListView.SelectedItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="#d8e9fa"
                                    Stroke="#009fe3" StrokeShape="RoundRectangle 10" StrokeThickness="2">
                                <Label FontAttributes="Bold" FontFamily="HankenGroteskBold" FontSize="12"
                                       Text="{Binding Text}" TextColor="#031926"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.SelectedItemTemplate>
            </syncfusion:SfListView>

            <!-- Pain / discomfort -->
            <Label
                Text="{Binding PainLabel}"
                FontFamily="HankenGroteskBold"
                FontSize="15"
                TextColor="#031926"
                HorizontalOptions="Start"
                Margin="0,10,0,0" />

            <syncfusion:SfListView
                x:Name="painlist"
                Margin="0,10,0,0"
                AutoFitMode="Height"
                BackgroundColor="Transparent"
                IsScrollingEnabled="False"
                Orientation="Vertical"
                ScrollBarVisibility="Never"
                SelectionBackground="Transparent"
                SelectionGesture="Tap"
                SelectionMode="Single"
                ItemsSource="{Binding PainOptions}"
                SelectedItem="{Binding SelectedPainOption, Mode=TwoWay}">
                <syncfusion:SfListView.ItemsLayout>
                    <syncfusion:GridLayout SpanCount="1" />
                </syncfusion:SfListView.ItemsLayout>
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="Transparent"
                                    Stroke="LightGray" StrokeShape="RoundRectangle 10">
                                <Label FontFamily="HankenGroteskRegular" FontSize="12"
                                       Text="{Binding Text}" TextColor="Gray"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
                <syncfusion:SfListView.SelectedItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="#d8e9fa"
                                    Stroke="#009fe3" StrokeShape="RoundRectangle 10" StrokeThickness="2">
                                <Label FontAttributes="Bold" FontFamily="HankenGroteskBold" FontSize="12"
                                       Text="{Binding Text}" TextColor="#031926"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.SelectedItemTemplate>
            </syncfusion:SfListView>

            <!-- Anxiety / depression -->
            <Label
                Text="{Binding DepressionLabel}"
                FontFamily="HankenGroteskBold"
                FontSize="15"
                TextColor="#031926"
                HorizontalOptions="Start"
                Margin="0,10,0,0" />

            <syncfusion:SfListView
                x:Name="deplist"
                Margin="0,10,0,0"
                AutoFitMode="Height"
                BackgroundColor="Transparent"
                IsScrollingEnabled="False"
                Orientation="Vertical"
                ScrollBarVisibility="Never"
                SelectionBackground="Transparent"
                SelectionGesture="Tap"
                SelectionMode="Single"
                ItemsSource="{Binding DepressionOptions}"
                SelectedItem="{Binding SelectedDepressionOption, Mode=TwoWay}">
                <syncfusion:SfListView.ItemsLayout>
                    <syncfusion:GridLayout SpanCount="1" />
                </syncfusion:SfListView.ItemsLayout>
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="Transparent"
                                    Stroke="LightGray" StrokeShape="RoundRectangle 10">
                                <Label FontFamily="HankenGroteskRegular" FontSize="12"
                                       Text="{Binding Text}" TextColor="Gray"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
                <syncfusion:SfListView.SelectedItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <Border Margin="5,5,5,5" Padding="20" BackgroundColor="#d8e9fa"
                                    Stroke="#009fe3" StrokeShape="RoundRectangle 10" StrokeThickness="2">
                                <Label FontAttributes="Bold" FontFamily="HankenGroteskBold" FontSize="12"
                                       Text="{Binding Text}" TextColor="#031926"
                                       InputTransparent="True" VerticalOptions="Center" />
                            </Border>
                        </ViewCell>
                    </DataTemplate>
                </syncfusion:SfListView.SelectedItemTemplate>
            </syncfusion:SfListView>

            <!-- Health slider -->
            <Label
                Text="{Binding HealthSliderLabel}"
                FontFamily="HankenGroteskBold"
                FontSize="15"
                TextColor="#031926"
                HorizontalOptions="Start"
                Margin="0,20,0,0" />

            <Label
                Text="{Binding HealthSliderSubLabel}"
                FontFamily="HankenGroteskRegular"
                FontSize="13"
                TextColor="#031926"
                HorizontalOptions="Start"
                Margin="0,10,0,0" />

            <Label
                Text="{Binding HealthSliderValue}"
                FontFamily="HankenGroteskBold"
                FontSize="35"
                TextColor="#031926"
                HorizontalOptions="Center"
                Margin="0,10,0,10" />

            <sliders:SfSlider
                x:Name="healthSlider"
                Padding="0"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                Maximum="100"
                Minimum="0"
                ShowLabels="False"
                ShowTicks="False"
                VerticalOptions="Center"
                Value="{Binding HealthSliderValue, Mode=TwoWay}">
                <sliders:SfSlider.TrackStyle>
                    <sliders:SliderTrackStyle
                        ActiveFill="#009fe3"
                        ActiveSize="5"
                        InactiveFill="LightGray"
                        InactiveSize="3" />
                </sliders:SfSlider.TrackStyle>
                <sliders:SfSlider.ThumbStyle>
                    <sliders:SliderThumbStyle
                        Fill="White"
                        Stroke="#009fe3"
                        StrokeThickness="2" />
                </sliders:SfSlider.ThumbStyle>
            </sliders:SfSlider>

            <Grid Margin="10,5" ColumnDefinitions="*, *">
                <Label Grid.Column="0" Text="{Binding Slider0Label}"
                       FontFamily="HankenGroteskRegular" FontSize="10"
                       TextColor="#031926" HorizontalOptions="Start" />
                <Label Grid.Column="1" Text="{Binding Slider100Label}"
                       FontFamily="HankenGroteskRegular" FontSize="10"
                       TextColor="#031926" HorizontalOptions="End" HorizontalTextAlignment="End" />
            </Grid>

        </VerticalStackLayout>
    </Grid>
</ContentView>
