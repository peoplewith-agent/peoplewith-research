<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PeopleWithResearch.Views.New.RegisterLogin.SignUpCodes.MainUserStepView">
    <Grid Padding="20,16,20,16">
        <VerticalStackLayout Spacing="12">
            <Border IsVisible="{Binding MainUserStackError}"
                    BackgroundColor="#FEE2E2" StrokeThickness="0"
                    StrokeShape="RoundRectangle 8" Padding="12,8">
                <Label Text="{Binding MainUserStackErrorMessage}"
                       TextColor="#991B1B" FontFamily="HankenGroteskRegular" FontSize="13"/>
            </Border>
            <Label Text="Household member 1 - First name"
                   FontFamily="HankenGroteskRegular" FontSize="14" TextColor="#374151"/>
            <Entry x:Name="FirstFamEntry" Placeholder="First name"
                   FontFamily="HankenGroteskRegular" FontSize="15" BackgroundColor="#F9FAFB"/>
            <Entry x:Name="FirstSurnameEntry" Placeholder="Surname"
                   FontFamily="HankenGroteskRegular" FontSize="15" BackgroundColor="#F9FAFB"/>
            <Entry x:Name="FirstEmailEntry" Placeholder="Email (optional)"
                   Keyboard="Email"
                   FontFamily="HankenGroteskRegular" FontSize="15" BackgroundColor="#F9FAFB"/>
            <Label Text="Household member 2 - First name"
                   FontFamily="HankenGroteskRegular" FontSize="14" TextColor="#374151"/>
            <Entry x:Name="FirstFamEntry2" Placeholder="First name"
                   FontFamily="HankenGroteskRegular" FontSize="15" BackgroundColor="#F9FAFB"/>
            <Entry x:Name="FirstSurnameEntry2" Placeholder="Surname"
                   FontFamily="HankenGroteskRegular" FontSize="15" BackgroundColor="#F9FAFB"/>
            <Entry x:Name="FirstEmailEntry2" Placeholder="Email (optional)"
                   Keyboard="Email"
                   FontFamily="HankenGroteskRegular" FontSize="15" BackgroundColor="#F9FAFB"/>
        </VerticalStackLayout>
    </Grid>
</ContentView>
