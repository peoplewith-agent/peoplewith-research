<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.FAQ_s"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:SyncExpand="clr-namespace:Syncfusion.Maui.Expander;assembly=Syncfusion.Maui.Expander"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:strings="clr-namespace:PeopleWithResearch.Resources.Strings;assembly=PeopleWithResearch"
    Background="White">
    <Grid Margin="20,20,20,0" RowDefinitions="Auto,Auto,Auto,Auto,*">

        <VerticalStackLayout
            Grid.Row="0"
            Margin="0"
            Spacing="2">
            <Label
                FontFamily="OpenSansSemiBold"
                FontSize="24"
                HorizontalOptions="Start"
                Text="{x:Static strings:AppResources.Faq_Title}"
                TextColor="#031926" />

            <Label
                FontFamily="OpenSansRegular"
                FontSize="14"
                HorizontalOptions="Start"
                Text="{x:Static strings:AppResources.Faq_Subtitle}"
                TextColor="#62727B" />
        </VerticalStackLayout>

        <Border
            Grid.Row="1"
            Margin="0,8"
            Background="#1Adedede"
            Stroke="#E2E8F0"
            StrokeShape="RoundRectangle 12"
            StrokeThickness="1">
            <Grid
                Margin="12,0"
                ColumnDefinitions="Auto,*,Auto"
                ColumnSpacing="10"
                HeightRequest="45">
                <Image
                    Grid.Column="0"
                    HeightRequest="18"
                    Opacity="0.6"
                    Source="mglass.png"
                    VerticalOptions="Center"
                    WidthRequest="18">
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="#62727B" />
                    </Image.Behaviors>
                </Image>

                <Entry
                    x:Name="SearchEntry"
                    Grid.Column="1"
                    FontFamily="OpenSansRegular"
                    FontSize="15"
                    Placeholder="Search FAQ's..."
                    PlaceholderColor="#94A3B8"
                    TextChanged="SearchEntry_TextChanged"
                    TextColor="#031926"
                    VerticalOptions="Center" />

                <Image
                    x:Name="ClearEntry"
                    Grid.Column="2"
                    HeightRequest="14"
                    IsVisible="false"
                    Opacity="0.5"
                    WidthRequest="14">
                    <Image.Source>
                        <FontImageSource Glyph="❌" />
                    </Image.Source>
                    <Image.Behaviors>
                        <toolkit:IconTintColorBehavior TintColor="gray" />
                    </Image.Behaviors>
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Tapped="ClearEntry_Tapped" />
                    </Image.GestureRecognizers>
                </Image>
            </Grid>
        </Border>

        <Grid
            x:Name="loadingstack"
            Grid.Row="2"
            Grid.RowSpan="3"
            IsVisible="False"
            VerticalOptions="Fill">
            <StackLayout VerticalOptions="Center">
                <ActivityIndicator IsRunning="True" Color="LightBlue" />
                <Label
                    FontAttributes="Bold"
                    FontSize="12"
                    HorizontalOptions="Center"
                    Text="{x:Static strings:AppResources.Faq_Loading}"
                    TextColor="Black" />
            </StackLayout>
        </Grid>

        <VerticalStackLayout
            x:Name="FilterStack"
            Grid.Row="2"
            Margin="0,4"
            IsVisible="False"
            Spacing="6">
            <Label
                CharacterSpacing="1"
                FontFamily="OpenSansSemiBold"
                FontSize="10"
                Text="{x:Static strings:AppResources.Faq_FilterBy}"
                TextColor="#94A3B8" />

            <syncfusion:SfListView
                x:Name="FiltersView"
                AutoFitMode="Height"
                Background="Transparent"
                BackgroundColor="Transparent"
                HeightRequest="38"
                HorizontalOptions="Fill"
                ItemSpacing="2.5"
                ItemTapped="FilterItem_Tapped"
                Orientation="Horizontal"
                ScrollBarVisibility="Never"
                SelectionBackground="Transparent"
                SelectionMode="Single">
                <syncfusion:SfListView.ItemTemplate>
                    <DataTemplate>
                        <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                            <Border
                                Background="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Grid Padding="10,0">
                                    <Label
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="13"
                                        HorizontalOptions="Center"
                                        Text="{Binding .}"
                                        TextColor="#62727B"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfListView.ItemTemplate>
                <syncfusion:SfListView.SelectedItemTemplate>
                    <DataTemplate>
                        <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                            <Border
                                Background="#031926"
                                Stroke="#031926"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="1">
                                <Grid Padding="10,0">
                                    <Label
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="13"
                                        HorizontalOptions="Center"
                                        Text="{Binding .}"
                                        TextColor="White"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </syncfusion:SfListView.SelectedItemTemplate>
            </syncfusion:SfListView>
        </VerticalStackLayout>

        <VerticalStackLayout
            x:Name="EmptyView"
            Grid.Row="3"
            Grid.RowSpan="2"
            Margin="0,30,0,0"
            IsVisible="False"
            Spacing="12"
            VerticalOptions="Center">
            <Border
                Padding="24"
                Background="White"
                HorizontalOptions="Center"
                MaximumWidthRequest="320"
                Stroke="#F1F5F9"
                StrokeShape="RoundRectangle 16">
                <Border.Shadow>
                    <Shadow
                        Brush="Black"
                        Opacity="0.04"
                        Radius="12"
                        Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout HorizontalOptions="Center" Spacing="10">
                    <Label
                        FontSize="36"
                        HorizontalOptions="Center"
                        Text="🔍" />
                    <Label
                        FontFamily="OpenSansSemiBold"
                        FontSize="16"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static strings:AppResources.Faq_NoFaqsFound}"
                        TextColor="#031926" />
                    <Label
                        FontFamily="OpenSansRegular"
                        FontSize="13"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="{x:Static strings:AppResources.Faq_NoFaqsMsg}"
                        TextColor="#62727B" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>


        <syncfusion:SfListView
            x:Name="FAQListView"
            Grid.Row="4"
            Margin="0,10,0,0"
            AutoFitMode="DynamicHeight"
            ItemSpacing="8"
            ItemTapped="FAQListView_ItemTapped"
            ScrollBarVisibility="Never"
            SelectionBackground="Transparent"
            SelectionMode="Single">
            <syncfusion:SfListView.ItemTemplate>
                <DataTemplate>
                    <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
                        <Border
                            Margin="0"
                            Background="White"
                            Stroke="#E2E8F0"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1">
                            <Border.Shadow>
                                <Shadow
                                    Brush="Black"
                                    Opacity="0.04"
                                    Radius="6"
                                    Offset="0,3" />
                            </Border.Shadow>
                            <Grid BackgroundColor="Transparent" RowDefinitions="Auto,Auto">

                                <Grid
                                    Grid.Row="0"
                                    Padding="10,14"
                                    BackgroundColor="White"
                                    ColumnDefinitions="*, Auto">
                                    <Label
                                        Grid.Column="0"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="15"
                                        Text="{Binding Title}"
                                        TextColor="#031926"
                                        VerticalOptions="Center" />
                                    <Label
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        FontSize="12"
                                        Text="▼"
                                        TextColor="#94A3B8"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsExpanded}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="Text" Value="▲" />
                                                <Setter Property="TextColor" Value="#031926" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>

                                <Grid
                                    Grid.Row="1"
                                    Padding="16,0,16,16"
                                    BackgroundColor="White"
                                    IsVisible="{Binding IsExpanded}">
                                    <Label
                                        FontFamily="OpenSansRegular"
                                        FontSize="14"
                                        Text="{Binding Description}"
                                        TextColor="#475569"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </DataTemplate>
            </syncfusion:SfListView.ItemTemplate>
        </syncfusion:SfListView>

    </Grid>
</ContentPage>