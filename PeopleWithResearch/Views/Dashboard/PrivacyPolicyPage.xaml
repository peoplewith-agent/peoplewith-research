<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.PrivacyPolicyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PeopleWithResearch"
    xmlns:strings="clr-namespace:PeopleWithResearch.Resources.Strings;assembly=PeopleWithResearch"
    BackgroundColor="White">
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="Ink">#031926</Color>
            <Color x:Key="Body">#3A4A55</Color>
            <Color x:Key="Muted">#8A97A0</Color>
            <Color x:Key="Accent">#009FE3</Color>

            <DataTemplate x:Key="HeadingTemplate">
                <VerticalStackLayout Margin="{Binding MarginThickness}" Spacing="6">
                    <Label
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemiBold"
                        FontSize="{Binding Style.FontSize}"
                        Text="{Binding Text}"
                        TextColor="{StaticResource Accent}" />
                    <BoxView
                        HeightRequest="2"
                        HorizontalOptions="Start"
                        WidthRequest="44"
                        Color="{StaticResource Accent}" />
                </VerticalStackLayout>
            </DataTemplate>

            <DataTemplate x:Key="SubheadingTemplate">
                <Label
                    Margin="{Binding MarginThickness}"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemiBold"
                    FontSize="{Binding Style.FontSize}"
                    Text="{Binding Text}"
                    TextColor="{StaticResource Ink}" />
            </DataTemplate>

            <DataTemplate x:Key="ParagraphTemplate">
                <Label
                    Margin="{Binding MarginThickness}"
                    FontFamily="OpenSansRegular"
                    FontSize="{Binding Style.FontSize}"
                    LineHeight="1.45"
                    Text="{Binding Text}"
                    TextColor="{StaticResource Body}" />
            </DataTemplate>

            <DataTemplate x:Key="CalloutTemplate">
                <Border
                    Margin="{Binding MarginThickness}"
                    Padding="14"
                    BackgroundColor="#EBF3FA"
                    Stroke="#BFDBF7"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Image
                            Grid.Column="0"
                            HeightRequest="18"
                            Source="info_icon.png"
                            VerticalOptions="Start"
                            WidthRequest="18" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="14"
                                IsVisible="{Binding HasTitle}"
                                Text="{Binding Title}"
                                TextColor="{StaticResource Ink}" />
                            <Label
                                FontFamily="OpenSansRegular"
                                FontSize="{Binding Style.FontSize}"
                                LineHeight="1.4"
                                Text="{Binding Text}"
                                TextColor="#0C447C" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="BulletListTemplate">
                <VerticalStackLayout
                    Margin="{Binding MarginThickness}"
                    BindableLayout.ItemsSource="{Binding Items}"
                    Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="18,*" ColumnSpacing="4">
                                <Label
                                    Grid.Column="0"
                                    FontSize="14"
                                    Text="•"
                                    TextColor="{StaticResource Accent}"
                                    VerticalOptions="Start" />
                                <Label
                                    Grid.Column="1"
                                    FontFamily="OpenSansRegular"
                                    FontSize="14"
                                    LineHeight="1.4"
                                    Text="{Binding .}"
                                    TextColor="{StaticResource Body}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </DataTemplate>

            <DataTemplate x:Key="KeyValueListTemplate">
                <VerticalStackLayout
                    Margin="{Binding MarginThickness}"
                    BindableLayout.ItemsSource="{Binding KeyValueItems}"
                    Spacing="12">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="3,*" ColumnSpacing="12">
                                <BoxView
                                    Grid.Column="0"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Fill"
                                    WidthRequest="3"
                                    Color="#BFDBF7" />
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="14"
                                        Text="{Binding Key}"
                                        TextColor="{StaticResource Ink}" />
                                    <Label
                                        FontFamily="OpenSansRegular"
                                        FontSize="14"
                                        LineHeight="1.4"
                                        Text="{Binding Value}"
                                        TextColor="{StaticResource Body}" />
                                </VerticalStackLayout>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </DataTemplate>

            <local:PolicySectionTemplateSelector
                x:Key="PolicySectionSelector"
                BulletListTemplate="{StaticResource BulletListTemplate}"
                CalloutTemplate="{StaticResource CalloutTemplate}"
                HeadingTemplate="{StaticResource HeadingTemplate}"
                KeyValueListTemplate="{StaticResource KeyValueListTemplate}"
                ParagraphTemplate="{StaticResource ParagraphTemplate}"
                SubheadingTemplate="{StaticResource SubheadingTemplate}" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <CollectionView
        x:Name="PrivacyCollection"
        Margin="20,0"
        ItemTemplate="{StaticResource PolicySectionSelector}"
        ItemsSource="{Binding Sections}">
        <CollectionView.Header>
            <VerticalStackLayout Padding="0,24,0,8" Spacing="0">
                <Label
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemiBold"
                    FontSize="11"
                    Text="{x:Static strings:AppResources.Privacy_FooterLinks}"
                    TextColor="{StaticResource Accent}" />
                <Label
                    Margin="0,10,0,0"
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemiBold"
                    FontSize="22"
                    Text="{Binding Document.Title}"
                    TextColor="{StaticResource Ink}" />
                <Label
                    Margin="0,6,0,0"
                    FontAttributes="Italic"
                    FontFamily="OpenSansRegular"
                    FontSize="15"
                    LineHeight="1.35"
                    Text="{Binding Document.Subtitle}"
                    TextColor="{StaticResource Body}" />
                <Border
                    Margin="0,14,0,0"
                    Padding="10,3"
                    BackgroundColor="#E8EBEF"
                    HorizontalOptions="Start"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 20">
                    <Label
                        FontSize="12"
                        Text="{Binding Document.Version}"
                        TextColor="{StaticResource Muted}" />
                </Border>
                <BoxView
                    Margin="0,18,0,10"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    Color="#DCE1E6" />
            </VerticalStackLayout>
        </CollectionView.Header>
        <CollectionView.ItemsLayout>
            <LinearItemsLayout ItemSpacing="0" Orientation="Vertical" />
        </CollectionView.ItemsLayout>
        <CollectionView.Footer>
            <BoxView HeightRequest="40" Color="White" />
        </CollectionView.Footer>
    </CollectionView>

</ContentPage>