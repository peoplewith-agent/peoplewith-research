                                                </VerticalStackLayout>
                                                <Image
                                                    Grid.Column="2"
                                                    HeightRequest="14"
                                                    Opacity="0.3"
                                                    Source="nextdarker.png"
                                                    VerticalOptions="Center"
                                                    WidthRequest="14" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </syncfusion:SfListView.ItemTemplate>

                                <syncfusion:SfListView.EmptyView>
                                    <VerticalStackLayout
                                        Padding="32"
                                        HorizontalOptions="Center"
                                        Spacing="12">
                                        <Border
                                            BackgroundColor="#F1F5F9"
                                            HeightRequest="64"
                                            HorizontalOptions="Center"
                                            StrokeShape="RoundRectangle 32"
                                            StrokeThickness="0"
                                            WidthRequest="64">
                                            <Image
                                                HeightRequest="28"
                                                HorizontalOptions="Center"
                                                Opacity="0.5"
                                                Source="webicon.png"
                                                VerticalOptions="Center"
                                                WidthRequest="28" />
                                        </Border>
                                        <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                            <Label
                                                FontAttributes="Bold"
                                                FontFamily="OpenSansSemiBold"
                                                FontSize="16"
                                                HorizontalTextAlignment="Center"
                                                Text="No Resources Found"
                                                TextColor="#0F172A" />
                                            <Label
                                                FontFamily="OpenSansRegular"
                                                FontSize="13"
                                                HorizontalTextAlignment="Center"
                                                Text="Resources failed to load. try load page again. if problem persists contact support."
                                                TextColor="#64748B" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </syncfusion:SfListView.EmptyView>
                            </syncfusion:SfListView>

                        </StackLayout>
                    </ScrollView>
                </tabView:SfTabItem.Content>
            </tabView:SfTabItem>

            <tabView:SfTabItem
                x:Name="profiletab"
                Background="Transparent"
                FontFamily="HankenGroteskRegular"
                FontSize="12"
                Header="Profile"
                ImageSize="25"
                ImageSource="dashbrowseinactive.png"
                ImageTextSpacing="2"
                TextColor="#b3babd">
                <tabView:SfTabItem.Content>
                    <ScrollView Background="Transparent" VerticalScrollBarVisibility="Never">

                        <StackLayout Margin="0,20,0,0" BackgroundColor="Transparent">

                            <HorizontalStackLayout
                                Margin="20,16,20,8"
                                Spacing="12"
                                VerticalOptions="Center">

                                <Image
                                    HeightRequest="40"
                                    HorizontalOptions="Center"
                                    Source="profileactive.png"
                                    VerticalOptions="Center"
                                    WidthRequest="40" />

                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">

                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="20"
                                        Text="Profile"
                                        TextColor="#0F172A" />

                                    <Label
                                        Margin="0,0,20,0"
                                        FontFamily="OpenSansRegular"
                                        FontSize="13"
                                        HorizontalOptions="Start"
                                        LineBreakMode="CharacterWrap"
                                        Text="Manage your profile"
                                        TextColor="#64748B" />
                                </VerticalStackLayout>

                            </HorizontalStackLayout>

                            <Border
                                Margin="20,10,20,0"
                                Padding="16"
                                BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow
                                        Brush="#031926"
                                        Opacity="0.04"
                                        Radius="12"
                                        Offset="0,4" />
                                </Border.Shadow>

                                <Grid
                                    ColumnDefinitions="Auto, *"
                                    ColumnSpacing="16"
                                    VerticalOptions="Center">

                                    <Border
                                        Grid.Column="0"
                                        HeightRequest="76"
                                        Stroke="#FFFFFF"
                                        StrokeShape="RoundRectangle 38"
                                        StrokeThickness="3"
                                        VerticalOptions="Center"
                                        WidthRequest="76">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Offset="0.0" Color="#A1C4FD" />
                                                <GradientStop Offset="1.0" Color="#C2E9FB" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Shadow>
                                            <Shadow
                                                Brush="#A1C4FD"
                                                Opacity="0.3"
                                                Radius="6"
                                                Offset="0,3" />
                                        </Border.Shadow>

                                        <Label
                                            x:Name="Initialslbl"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="22"
                                            HorizontalOptions="Center"
                                            Text="PW"
                                            TextColor="#FFFFFF"
                                            TextTransform="Uppercase"
                                            VerticalOptions="Center" />
                                    </Border>

                                    <VerticalStackLayout
                                        Grid.Column="1"
                                        Spacing="8"
                                        VerticalOptions="Center">
                                        <Label
                                            x:Name="emaillbl"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="16"
                                            HorizontalOptions="Start"
                                            Text="user@email.com"
                                            TextColor="#031926" />

                                        <Border
                                            Padding="12,6"
                                            BackgroundColor="#F8FAFC"
                                            HorizontalOptions="Start"
                                            Stroke="#E2E8F0"
                                            StrokeShape="RoundRectangle 8"
                                            StrokeThickness="1">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="TapGestureRecognizer_Tapped_2" />
                                            </Border.GestureRecognizers>

                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                <Label
                                                    FontFamily="OpenSansRegular"
                                                    FontSize="12"
                                                    Text="ID:"
                                                    TextColor="#64748B"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    x:Name="useridprofilelbl"
                                                    FontAttributes="Bold"
                                                    FontFamily="OpenSansSemiBold"
                                                    FontSize="13"
                                                    Text="HP-123423235"
                                                    TextColor="#031926"
                                                    VerticalOptions="Center" />
                                                <Image
                                                    HeightRequest="14"
                                                    Opacity="0.6"
                                                    Source="copyicon.png"
                                                    VerticalOptions="Center"
                                                    WidthRequest="14" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>

                            <VerticalStackLayout Spacing="12">
                                <Label
                                    Margin="24,20,24,0"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="16"
                                    Text="Personal Information"
                                    TextColor="#031926" />

                                <Border
                                    Margin="20,0"
                                    Padding="16,0,16,0"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1">
                                    <syncfusion:SfListView
                                        x:Name="profiledetailslist"
                                        Margin="0,-1,0,0"
                                        AutoFitMode="DynamicHeight"
                                        IsScrollingEnabled="False"
                                        ItemTapped="profiledetailslist_Tapped"
                                        ItemTemplate="{StaticResource SFItemTemplate}"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="12">
                                <Label
                                    Margin="24,20,24,0"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="16"
                                    Text="Preferences"
                                    TextColor="#031926" />

                                <Border
                                    Margin="20,0"
                                    Padding="16,0,16,0"
                                    BackgroundColor="White"
                                    Stroke="#E2E8F0"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="1">
                                    <syncfusion:SfListView
                                        x:Name="Settingslist"
                                        Margin="0,-1,0,0"
                                        AutoFitMode="DynamicHeight"
                                        IsScrollingEnabled="False"
                                        ItemTapped="Settingslist_ItemTapped"
                                        ItemTemplate="{StaticResource SFItemTemplate}"
                                        ScrollBarVisibility="Never"
                                        SelectionBackground="Transparent" />
                                </Border>
                            </VerticalStackLayout>

                            <Border
                                Margin="20,20,20,0"
                                Padding="20"
                                BackgroundColor="White"
                                Stroke="#E2E8F0"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="1">
                                <Border.Shadow>
                                    <Shadow
                                        Brush="#031926"
                                        Opacity="0.04"
                                        Radius="12"
                                        Offset="0,4" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="10">
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="18"
                                        Text="Get in Touch"
                                        TextColor="#031926" />
                                    <Label
                                        FontFamily="OpenSansRegular"
                                        FontSize="14"
                                        Text="Need a hand? We're here to help with anything you need. Reach out to our support team anytime."
                                        TextColor="#64748B" />
                                    <Button
                                        Margin="0,8,0,0"
                                        BackgroundColor="#009fe3"
                                        Clicked="MessageTeam_Clicked"
                                        CornerRadius="12"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        HeightRequest="48"
                                        Text="Message the Team"
                                        TextColor="White">
                                        <Button.Shadow>
                                            <Shadow
                                                Brush="#009fe3"
                                                Opacity="0.25"
                                                Radius="8"
                                                Offset="0,4" />
                                        </Button.Shadow>
                                    </Button>
                                </VerticalStackLayout>
                            </Border>

                            <!--  Footer Section (Actions & Info)  -->
                            <VerticalStackLayout Margin="20,40,20,0" Spacing="16">

                                <!--  Logout Button  -->
                                <Button
                                    x:Name="LogoutBtn"
                                    BackgroundColor="Transparent"
                                    BorderColor="#009fe3"
                                    BorderWidth="1.5"
                                    Clicked="Logout_Clicked"
                                    CornerRadius="12"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    HeightRequest="50"
                                    Text="Log Out"
                                    TextColor="#009fe3" />


                                <Border
                                    Margin="0,200,0,0"
                                    Padding="16"
                                    BackgroundColor="#FEF2F2"
                                    Stroke="#FECACA"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="WithdrawfromStudy" />
                                    </Border.GestureRecognizers>

                                    <Grid
                                        ColumnDefinitions="Auto, *"
                                        ColumnSpacing="14"
                                        VerticalOptions="Center">
                                        <Image
                                            Grid.Column="0"
                                            Margin="0,2,0,0"
                                            HeightRequest="24"
                                            Source="exitwhite.png"
                                            VerticalOptions="Start"
                                            WidthRequest="24">
                                            <Image.Behaviors>
                                                <toolkit:IconTintColorBehavior TintColor="#DC2626" />
                                            </Image.Behaviors>
                                        </Image>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                                            <Label
                                                CharacterSpacing="1"
                                                FontAttributes="Bold"
                                                FontFamily="OpenSansSemiBold"
                                                FontSize="11"
                                                Text="WITHDRAWAL ACTION"
                                                TextColor="#DC2626" />
                                            <Label
                                                FontAttributes="Bold"
                                                FontFamily="OpenSansSemiBold"
                                                FontSize="15"
                                                Text="Withdraw from HOPPER Study"
                                                TextColor="#7F1D1D" />
                                            <Label
                                                FontFamily="OpenSansRegular"
                                                FontSize="13"
                                                Text="Once withdrawn, you will no longer be part of this study and lose access to your account."
                                                TextColor="#991B1B" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <!--  App Version  -->
                                <Label
                                    x:Name="Versionlbl"
                                    Margin="0,16,0,20"
                                    FontFamily="OpenSansRegular"
                                    FontSize="13"
                                    HorizontalOptions="Center"
                                    Text="App Version 1.0.0"
                                    TextColor="#94A3B8" />

                            </VerticalStackLayout>

                        </StackLayout>

                    </ScrollView>

                </tabView:SfTabItem.Content>
            </tabView:SfTabItem>

        </tabView:SfTabView>




    </Grid>


</ContentPage>