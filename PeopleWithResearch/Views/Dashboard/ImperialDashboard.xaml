                                IsVisible="False"
                                Stroke="#009fe3"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="2">


                                <VerticalStackLayout Spacing="0">

                                    <Image
                                        Margin="5,0,0,10"
                                        HeightRequest="35"
                                        HorizontalOptions="Start"
                                        IsVisible="True"
                                        Source="waiting.png"
                                        VerticalOptions="Start"
                                        WidthRequest="35">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="#f59e0b" />
                                        </Image.Behaviors>
                                    </Image>

                                    <!--  Tag  -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="12"
                                        Text="STUDY PROGRESS"
                                        TextColor="#009FE3" />


                                    <Label
                                        Margin="0,6,0,0"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="22"
                                        LineBreakMode="WordWrap"
                                        Text="Daily recording complete"
                                        TextColor="#031926" />


                                    <!--  Subtitle  -->
                                    <Label
                                        Margin="0,6,0,15"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        Text="You no longer need to complete daily symptom forms. Your next step is your final Day 28 questionnaire. After that you will need to complete a short End of Study form to finish your participation."
                                        TextColor="#031926" />


                                    <!--  Title  -->
                                    <Label
                                        Margin="0,6,0,0"
                                        FontSize="16"
                                        LineBreakMode="WordWrap">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontAttributes="Bold"
                                                    FontFamily="OpenSansSemiBold"
                                                    Text="Your household is on "
                                                    TextColor="#031926" />
                                                <Span
                                                    x:Name="waitingdaylbl"
                                                    FontAttributes="Bold"
                                                    FontFamily="OpenSansSemiBold"
                                                    FontSize="16"
                                                    TextColor="#009fe3" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>


                                    <progressBar:SfLinearProgressBar
                                        x:Name="waitingfirstpb"
                                        Margin="10,20,10,0"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Fill"
                                        Maximum="14"
                                        ProgressCornerRadius="5"
                                        ProgressFill="#009fe3"
                                        ProgressHeight="8"
                                        SegmentCount="14"
                                        TrackCornerRadius="5"
                                        TrackHeight="8" />

                                    <progressBar:SfLinearProgressBar
                                        x:Name="waitingsecondpb"
                                        Margin="10,10,10,10"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Fill"
                                        Maximum="14"
                                        ProgressCornerRadius="10"
                                        ProgressFill="#009fe3"
                                        ProgressHeight="8"
                                        SegmentCount="14"
                                        TrackCornerRadius="10"
                                        TrackHeight="8" />
                                    <!--  CTA row  -->


                                </VerticalStackLayout>
                            </Border>


                            <!--  End questionnaire Study Border  -->
                            <Border
                                x:Name="endofstudyborder"
                                Margin="20,10,20,0"
                                Padding="15"
                                BackgroundColor="#f8f9fb"
                                IsVisible="False"
                                Stroke="#009fe3"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="2">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_7" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="0">

                                    <Image
                                        Margin="5,0,0,10"
                                        HeightRequest="35"
                                        HorizontalOptions="Start"
                                        IsVisible="True"
                                        Source="endstudy.png"
                                        VerticalOptions="Start"
                                        WidthRequest="35">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="#f59e0b" />
                                        </Image.Behaviors>
                                    </Image>

                                    <!--  Tag  -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="12"
                                        Text="STUDY PROGRESS"
                                        TextColor="#009FE3" />


                                    <Label
                                        Margin="0,6,0,0"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="22"
                                        LineBreakMode="WordWrap"
                                        Text="Congratulations – Your household has reached the End of Study Feedback Stage!"
                                        TextColor="#031926" />


                                    <!--  Subtitle  -->
                                    <Label
                                        Margin="0,6,0,15"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        Text="Thank you for taking part in the HOPPER Study. Your participation has made an important contribution to our research. "
                                        TextColor="#031926" />


                                    <!--  Title  -->
                                    <Label
                                        Margin="0,6,0,0"
                                        FontSize="15"
                                        LineBreakMode="WordWrap">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span
                                                    FontAttributes="Bold"
                                                    FontFamily="OpenSansSemiBold"
                                                    Text="Please tap here to complete a short final questionnaire before finishing your participation in the study."
                                                    TextColor="#031926" />

                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>


                                    <Grid Margin="5,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Grid.Column="0"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="14"
                                            Text="Tap to complete questionnaire"
                                            TextColor="#009fe3"
                                            VerticalOptions="Center" />
                                        <Border
                                            Grid.Column="1"
                                            BackgroundColor="#009fe3"
                                            HeightRequest="32"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 16"
                                            WidthRequest="32">
                                            <Image
                                                HeightRequest="16"
                                                HorizontalOptions="Center"
                                                Source="rightarrow.png"
                                                VerticalOptions="Center"
                                                WidthRequest="16" />
                                        </Border>
                                    </Grid>

                                </VerticalStackLayout>
                            </Border>

                            <!--  End Study complete Border  -->
                            <Border
                                x:Name="studycompleteborder"
                                Margin="20,10,20,0"
                                Padding="15"
                                BackgroundColor="#F0FDF9"
                                IsVisible="False"
                                Stroke="#0D9488"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="2">

                                <VerticalStackLayout Spacing="0">

                                    <Image
                                        Margin="5,0,0,10"
                                        HeightRequest="35"
                                        HorizontalOptions="Start"
                                        Source="happy.png"
                                        VerticalOptions="Start"
                                        WidthRequest="35">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="#0D9488" />
                                        </Image.Behaviors>
                                    </Image>

                                    <!--  Tag  -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="12"
                                        Text="STUDY COMPLETE"
                                        TextColor="#0D9488" />

                                    <!--  Title  -->
                                    <Label
                                        Margin="0,6,0,0"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="22"
                                        LineBreakMode="WordWrap"
                                        Text="Thank you for taking part!"
                                        TextColor="#042F2E" />

                                    <!--  Subtitle  -->
                                    <Label
                                        Margin="0,10,0,0"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        Text="Your participation in the HOPPER study is now complete. The data you have contributed will make a real difference to our understanding of respiratory illnesses in households."
                                        TextColor="#134E4A" />

                                    <!--  Divider  -->
                                    <BoxView
                                        Margin="0,14,0,14"
                                        BackgroundColor="#99F6E4"
                                        HeightRequest="1" />

                                    <!--  Restart info  -->
                                    <Label
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        Text="Want to restart the study?"
                                        TextColor="#042F2E" />

                                    <Label
                                        Margin="0,4,0,0"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="13"
                                        LineBreakMode="WordWrap"
                                        Text="If you or someone in your household develops new symptoms and you would like to restart the triggered sampling period, please contact the study team directly."
                                        TextColor="#134E4A" />

                                    <!--  Contact button  -->
                                    <Border
                                        Margin="0,14,0,0"
                                        Padding="14,10"
                                        BackgroundColor="#0D9488"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontFamily="OpenSansSemiBold"
                                                FontSize="14"
                                                Text="Contact the study team"
                                                TextColor="White"
                                                VerticalOptions="Center" />
                                            <Image
                                                Grid.Column="1"
                                                HeightRequest="16"
                                                HorizontalOptions="End"
                                                Source="rightarrow.png"
                                                VerticalOptions="Center"
                                                WidthRequest="16" />
                                        </Grid>

                                    </Border>

                                </VerticalStackLayout>
                            </Border>



                            <!--<Grid
                                x:Name="CompletedQuestions"
                                Margin="20,20,20,0"
                                ColumnDefinitions="*"
                                IsVisible="False"
