<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.ImperialDashboard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:data="clr-namespace:Syncfusion.Maui.DataSource;assembly=Syncfusion.Maui.DataSource"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:shimmer="clr-namespace:Syncfusion.Maui.Shimmer;assembly=Syncfusion.Maui.Core"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    xmlns:syncfusionpdf="clr-namespace:Syncfusion.Maui.PdfViewer;assembly=Syncfusion.Maui.PdfViewer"
    xmlns:tabView="clr-namespace:Syncfusion.Maui.TabView;assembly=Syncfusion.Maui.TabView"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    ios:Page.UseSafeArea="True"
    BackgroundColor="White"
    NavigationPage.HasNavigationBar="False"
    Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush EndPoint="0,0.2">
            <GradientStop Offset="0.0" Color="#66c5ee" />
            <GradientStop Offset="1.0" Color="White" />
        </LinearGradientBrush>
    </ContentPage.Background>



    <ContentPage.Resources>

        <DataTemplate x:Key="QuestionnaireItemTemplate">
            <Border
                Margin="4,0"
                Padding="16,16,0,16"
                BackgroundColor="#F8F9FB"
                Stroke="#E5E7EB"
                StrokeShape="RoundRectangle 12"
                StrokeThickness="1">

                <Border.Shadow>
                    <Shadow
                        Brush="#000000"
                        Opacity="0.04"
                        Radius="6"
                        Offset="0,2" />
                </Border.Shadow>

                <Grid
                    ColumnDefinitions="Auto, *, Auto"
                    ColumnSpacing="5"
                    RowDefinitions="Auto, Auto"
                    RowSpacing="1">

                    <Image
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="0"
                        HeightRequest="30"
                        Source="questionnaireicon.png"
                        VerticalOptions="Center"
                        WidthRequest="30" />

                    <Label
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemiBold"
                        FontSize="14"
                        LineBreakMode="CharacterWrap"
                        Text="{Binding DisplayTitle}"
                        TextColor="#031926"
                        VerticalOptions="Center" />

                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="1"
                        BackgroundColor="Transparent"
                        HorizontalOptions="Start"
                        Spacing="2"
                        VerticalOptions="Center">

                        <Border
                            Padding="8,4"
                            BackgroundColor="#F9FAFB"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="1">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Image
                                    HeightRequest="10"
                                    Source="clock.png"
                                    VerticalOptions="Center"
                                    WidthRequest="10">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="#009fe3" />
                                    </Image.Behaviors>
                                </Image>
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansRegular"
                                    FontSize="12"
                                    Text="{Binding FormattedDateTime}"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border
                            Padding="8,4"
                            BackgroundColor="#F9FAFB"
                            IsVisible="{Binding ShowCompletedBy}"
                            Stroke="Transparent"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="1">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Image
                                    HeightRequest="10"
                                    Source="profileactive.png"
                                    VerticalOptions="Center"
                                    WidthRequest="10">
                                    <Image.Behaviors>
                                        <toolkit:IconTintColorBehavior TintColor="#031926" />
                                    </Image.Behaviors>
                                </Image>
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="12"
                                    Text="{Binding CompletedBy}"
                                    TextColor="Gray"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                    </HorizontalStackLayout>

                    <Image
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        HeightRequest="14"
                        HorizontalOptions="End"
                        Opacity="0.4"
                        Source="chevron_right.png"
                        VerticalOptions="Center"
                        WidthRequest="14" />

                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SFItemTemplate">
            <Grid BackgroundColor="Transparent" RowDefinitions="Auto, *">

                <BoxView
                    Grid.Row="0"
                    HeightRequest="1"
                    HorizontalOptions="Fill"
                    Color="#F1F5F9" />

                <Grid
                    Grid.Row="1"
                    Padding="0,16,0,16"
                    ColumnDefinitions="Auto, *, Auto"
                    ColumnSpacing="16"
                    VerticalOptions="Center">

                    <Image
                        Grid.Column="0"
                        HeightRequest="18"
                        Source="{Binding Image}"
                        VerticalOptions="Center"
                        WidthRequest="18">
                        <Image.Behaviors>
                            <toolkit:IconTintColorBehavior TintColor="#009fe3" />
                        </Image.Behaviors>
                    </Image>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="2"
                        VerticalOptions="Center">
                        <Label
                            FontFamily="OpenSansRegular"
                            FontSize="12"
                            Text="{Binding Title}"
                            TextColor="#64748B" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="15"
                            Text="{Binding Role}"
                            TextColor="#031926" />
                    </VerticalStackLayout>

                    <Image
                        Grid.Column="2"
                        HeightRequest="14"
                        Opacity="0.4"
                        Source="nextdarker.png"
                        VerticalOptions="Center"
                        WidthRequest="14" />
                </Grid>
            </Grid>
        </DataTemplate>

    </ContentPage.Resources>

    <Grid>
        <tabView:SfTabView
            x:Name="tabsview"
            BackgroundColor="Transparent"
            IndicatorBackground="#031926"
            IndicatorPlacement="Bottom"
            TabBarHeight="50"
            TabBarPlacement="Bottom"
            TabItemTapped="tabsview_TabItemTapped">

            <tabView:SfTabItem
                x:Name="hometab"
                FontAttributes="Bold"
                FontFamily="OpenSansSemiBold"
                FontSize="12"
                Header="Home"
                ImageSize="25"
                ImageSource="dashiconactive.png"
                ImageTextSpacing="2"
                TextColor="#031926">
                <tabView:SfTabItem.Content>

                    <ScrollView BackgroundColor="Transparent" VerticalScrollBarVisibility="Never">
                        <StackLayout
                            x:Name="DashboardStack"
                            Margin="0,20,0,0"
                            BackgroundColor="Transparent"
                            IgnoreSafeArea="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Grid.Column="0"
                                    Margin="20,0,0,0"
                                    HeightRequest="35"
                                    HorizontalOptions="Start"
                                    Source="hopperlogo.png"
                                    VerticalOptions="Center" />

                                <Image
                                    Grid.Column="1"
                                    Margin="0,0,20,0"
                                    HeightRequest="20"
                                    HorizontalOptions="End"
                                    Source="pwlogo.png"
                                    VerticalOptions="End" />
                            </Grid>



                            <Grid x:Name="welcomegrid" Margin="20,40,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>



                                <Label
                                    x:Name="welcomelbl"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,0"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemiBold"
                                    FontSize="22"
                                    HorizontalOptions="Start"
                                    TextColor="#031926" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="0,0,0,0"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansRegular"
                                    FontSize="14"
                                    HorizontalOptions="Start"
                                    Text="Welcome back to your dashboard"
                                    TextColor="Gray" />




                            </Grid>

                            <Grid>
                                <Button
                                    x:Name="T1Questionnaire"
                                    Margin="20"
                                    Padding="10"
                                    BackgroundColor="#009fe3"
                                    Clicked="T1Questionnaire_Clicked"
                                    CornerRadius="15"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansBold"
                                    HorizontalOptions="Fill"
                                    IsVisible="False"
                                    Text="T1Questionnaire"
                                    TextColor="White" />

                            </Grid>

                            <Button
                                Grid.Column="1"
                                Margin="20,10,20,0"
                                BackgroundColor="#009FE3"
                                Clicked="Button_Clicked_1"
                                CornerRadius="12"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemi"
                                FontSize="14"
                                IsVisible="False"
                                Text="Test"
                                TextColor="White" />

                            <!--  Active profile chip  -->
                            <Border
                                Margin="20,10,20,0"
                                Padding="12,6"
                                BackgroundColor="#E6F5FC"
                                HorizontalOptions="Center"
                                Stroke="#009FE3"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Image
                                        HeightRequest="20"
                                        Source="switchprofile.png"
                                        VerticalOptions="Center"
                                        WidthRequest="30">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="#009FE3" />
                                        </Image.Behaviors>
                                    </Image>
                                    <Label
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="12"
                                        VerticalOptions="Center">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="Logged in as " TextColor="#505050" />
                                                <Span
                                                    x:Name="activeProfileChipName"
                                                    FontAttributes="Bold"
                                                    TextColor="#009FE3" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </HorizontalStackLayout>
                            </Border>

                            <!--  study if info  -->
                            <Border
                                Margin="20,10,20,10"
                                Padding="20,15"
                                BackgroundColor="#F8F9FB"
                                Stroke="Transparent"
                                StrokeShape="RoundRectangle 16">

                                <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="20">

                                    <!--  Main ID Section  -->
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="12"
                                            Text="STUDY USER ID"
                                            TextColor="#707070" />
                                        <Label
                                            x:Name="studyidlbl"
                                            Margin="0,2,0,0"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="24"
                                            Text="HP-153"
                                            TextColor="#031926" />
                                    </VerticalStackLayout>


                                    <!--  Role Badge Section  -->
                                    <VerticalStackLayout
                                        x:Name="rolestack"
                                        Grid.Column="1"
                                        HorizontalOptions="Center"
                                        IsVisible="False"
                                        Spacing="2"
                                        VerticalOptions="Center">
                                        <Image
                                            x:Name="TypeImage"
                                            Aspect="AspectFit"
                                            HeightRequest="24"
                                            Source="home.png"
                                            WidthRequest="22" />
                                        <Label
                                            x:Name="UserType"
                                            FontFamily="OpenSansRegular"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            Text="House Rep"
                                            TextColor="#505050" />
                                    </VerticalStackLayout>

                                    <!--  Family Count Section  -->
                                    <VerticalStackLayout
                                        x:Name="activestack"
                                        Grid.Column="2"
                                        HorizontalOptions="Center"
                                        IsVisible="False"
                                        Spacing="0"
                                        VerticalOptions="Center">
                                        <Label
                                            x:Name="familycountlbl"
                                            FontAttributes="None"
                                            FontFamily="OpenSansRegular"
                                            FontSize="20"
                                            HorizontalTextAlignment="Center"
                                            TextColor="#031926" />
                                        <Label
                                            FontFamily="OpenSansRegular"
                                            FontSize="10"
                                            HorizontalTextAlignment="Center"
                                            Text="Active No."
                                            TextColor="#505050" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        x:Name="householdIcon"
                                        Grid.Column="1"
                                        HorizontalOptions="Center"
                                        IsVisible="False"
                                        Spacing="2"
                                        VerticalOptions="Center">

                                        <Border
                                            Padding="0"
                                            BackgroundColor="#EAEFF5"
                                            HeightRequest="40"
                                            HorizontalOptions="Center"
                                            Stroke="Transparent"
                                            StrokeShape="RoundRectangle 18"
                                            VerticalOptions="Center"
                                            WidthRequest="40">
                                            <Image
                                                Aspect="AspectFit"
                                                HeightRequest="20"
                                                HorizontalOptions="Center"
                                                Source="home.png"
                                                VerticalOptions="Center"
                                                WidthRequest="20" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout
                                        x:Name="householdRepName"
                                        Grid.Column="2"
                                        HorizontalOptions="Center"
                                        IsVisible="False"
                                        Spacing="0"
                                        VerticalOptions="Center">
                                        <Label
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="12"
                                            HorizontalTextAlignment="Center"
                                            Text="HOUSEHOLD REP"
                                            TextColor="#707070" />
                                        <Label
                                            x:Name="householdreplbl"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="16"
                                            HorizontalTextAlignment="Center"
                                            TextColor="#031926" />
                                    </VerticalStackLayout>



                                </Grid>
                            </Border>



                            <!--  Enable Notifications  -->
                            <Border
                                x:Name="EnableNotificationStack"
                                Margin="20,10,20,10"
                                Padding="24"
                                BackgroundColor="White"
                                IsVisible="False"
                                Stroke="#E6F6FF"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="1">

                                <Border.Shadow>
                                    <Shadow
                                        Brush="#031926"
                                        Opacity="0.05"
                                        Radius="16"
                                        Offset="0,8" />
                                </Border.Shadow>

                                <Grid
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="10"
                                    RowDefinitions="Auto,Auto,Auto,Auto"
                                    RowSpacing="0">

                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="0"
                                        Margin="0,2,0,0"
                                        Padding="0"
                                        BackgroundColor="#EFF9FF"
                                        HeightRequest="50"
                                        StrokeShape="RoundRectangle 28"
                                        StrokeThickness="0"
                                        VerticalOptions="Start"
                                        WidthRequest="50">

                                        <Image
                                            HeightRequest="22"
                                            HorizontalOptions="Center"
                                            Source="ringing.png"
                                            VerticalOptions="Center"
                                            WidthRequest="22">

                                            <Image.Behaviors>
                                                <toolkit:IconTintColorBehavior TintColor="#009FE3" />
                                            </Image.Behaviors>

                                        </Image>

                                    </Border>

                                    <Label
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemi"
                                        FontSize="18"
                                        Text="Stay in the loop"
                                        TextColor="#031926"
                                        VerticalOptions="End" />

                                    <Border
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="2"
                                        Padding="10,4"
                                        BackgroundColor="#E6F6FF"
                                        HorizontalOptions="End"
                                        StrokeShape="RoundRectangle 12"
                                        StrokeThickness="0"
                                        VerticalOptions="Start">
                                        <Label
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="10"
                                            Text="ACTION"
                                            TextColor="#009FE3" />

                                    </Border>

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        FontFamily="OpenSansRegular"
                                        FontSize="12"
                                        Text="Never miss an update"
                                        TextColor="#009FE3"
                                        VerticalOptions="Start" />

                                    <Label
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3"
                                        Margin="0,10"
                                        FontFamily="OpenSansRegular"
                                        FontSize="14"
                                        LineBreakMode="WordWrap"
                                        Text="Enable notifications to get instant questionnaire alerts, weekly study reminders, and progress updates for everyone in your household."
                                        TextColor="#475569" />

                                    <Grid
                                        Grid.Row="3"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="0"
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="12">

                                        <Button
                                            Grid.Column="0"
                                            BackgroundColor="#F8FAFC"
                                            BorderColor="#E2E8F0"
                                            BorderWidth="1"
                                            Clicked="NotNow_Clicked"
                                            CornerRadius="12"
                                            FontFamily="OpenSansSemiBold"
                                            FontSize="12"
                                            Text="Not Now"
                                            TextColor="#CC64748B" />

                                        <Button
                                            Grid.Column="1"
                                            BackgroundColor="#009FE3"
                                            Clicked="Enable_Clicked"
                                            CornerRadius="12"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemi"
                                            FontSize="14"
                                            Text="Enable"
                                            TextColor="White" />

                                    </Grid>

                                </Grid>

                            </Border>

                            <!--  Completed tasks  -->
                            <Border
                                x:Name="completedtaskborder"
                                Margin="20,20,20,0"
                                Padding="15"
                                BackgroundColor="#f0fdf4"
                                IsVisible="False"
                                Stroke="Green"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="2">

                                <StackLayout VerticalOptions="Start">



                                    <Image
                                        Margin="5,0,0,10"
                                        HeightRequest="50"
                                        HorizontalOptions="Start"
                                        IsVisible="True"
                                        Source="finishtick.png"
                                        VerticalOptions="Start"
                                        WidthRequest="50" />

                                    <!--  Tag  -->
                                    <Label
                                        Grid.Row="0"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="12"
                                        Text="STUDY PROGRESS"
                                        TextColor="#031926" />

                                    <!--  Title  -->
                                    <Label
                                        Grid.Row="1"
                                        Margin="0,10,0,0"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="22"
                                        LineBreakMode="WordWrap"
                                        Text="All tasks completed for today"
                                        TextColor="Green" />

                                    <!--  Subtitle  -->
                                    <Label
                                        Grid.Row="2"
                                        Margin="0,10,0,0"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="14"
                                        Text="You have completed today's questionnaire. Your next questionnaire will be available tomorrow. Please check that all other household members have also completed their forms for today"
                                        TextColor="Green" />




                                </StackLayout>

                            </Border>

                            <!--  awaiting basline form  -->
                            <Border
                                x:Name="stage1awaitingbaseline"
                                Margin="20,10,20,0"
                                Padding="15"
                                BackgroundColor="#F8F9FB"
                                IsVisible="False"
                                Stroke="#009fe3"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="2">

                                <StackLayout VerticalOptions="Start">



                                    <Image
                                        Margin="5,0,0,10"
                                        HeightRequest="35"
                                        HorizontalOptions="Start"
                                        IsVisible="True"
                                        Source="notificationicon.png"
                                        VerticalOptions="Start"
                                        WidthRequest="35">
                                        <Image.Behaviors>
                                            <toolkit:IconTintColorBehavior TintColor="#f59e0b" />
                                        </Image.Behaviors>
                                    </Image>


                                    <!--  Tag  -->
                                    <Label
                                        Grid.Row="0"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="12"
                                        Text="STUDY PROGRESS"
                                        TextColor="#009fe3" />


                                    <!--  Title  -->
                                    <Label
                                        Grid.Row="1"
                                        Margin="0,5,0,0"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="22"
                                        LineBreakMode="WordWrap"
                                        Text="Your household is at the baseline form stage"
                                        TextColor="#031926" />

                                    <!--  Subtitle  -->
                                    <Label
                                        Grid.Row="2"
                                        Margin="0,5,0,0"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="14"
                                        Text="To progress to the next stage of the study, at least 3 household members must complete the baseline form"
                                        TextColor="#031926" />


                                    <Label
                                        x:Name="percentlbl"
                                        Margin="0,10,10,0"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="25"
                                        HorizontalOptions="End"
                                        IsVisible="False"
                                        TextColor="#031926" />

                                    <Grid Margin="10,20,10,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="33*" />
                                            <ColumnDefinition Width="33*" />
                                            <ColumnDefinition Width="33*" />
                                        </Grid.ColumnDefinitions>

                                        <Image
                                            x:Name="addimage1"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            HeightRequest="25"
                                            HorizontalOptions="Center"
                                            Source="addusergray.png"
                                            VerticalOptions="End" />

                                        <Image
                                            x:Name="addimage2"
                                            Grid.Row="0"
                                            Grid.Column="1"
                                            HeightRequest="25"
                                            HorizontalOptions="Center"
                                            Source="addusergray.png"
                                            VerticalOptions="End" />

                                        <Image
                                            x:Name="addimage3"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            HeightRequest="25"
                                            HorizontalOptions="Center"
                                            Source="addusergray.png"
                                            VerticalOptions="End" />
                                    </Grid>


                                    <progressBar:SfLinearProgressBar
                                        x:Name="percentpb"
                                        Margin="10,20,10,0"
                                        AnimationEasing="{x:Static Easing.CubicInOut}"
                                        BackgroundColor="Transparent"
                                        HorizontalOptions="Center"
                                        Maximum="3"
                                        ProgressCornerRadius="5"
                                        ProgressFill="#009fe3"
                                        ProgressHeight="6"
                                        SecondaryProgressFill="LightBlue"
                                        SegmentCount="3"
                                        TrackCornerRadius="5"
                                        TrackFill="#3366c5ee"
                                        TrackHeight="6"
                                        VerticalOptions="Center" />


                                    <Border
                                        Margin="0,20,0,0"
                                        Padding="15"
                                        BackgroundColor="#f8f9fb"
                                        IsVisible="False"
                                        Stroke="Red"
                                        StrokeShape="RoundRectangle 10"
                                        StrokeThickness="1">

                                        <Grid VerticalOptions="Center">

                                            <!--  Columns  -->
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--  Icon  -->
                                            <Grid
                                                BackgroundColor="Transparent"
                                                HeightRequest="45"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center"
                                                WidthRequest="45">

                                                <Image
                                                    HeightRequest="25"
                                                    HorizontalOptions="Center"
                                                    Source="alert.png"
                                                    VerticalOptions="Center" />
                                            </Grid>

                                            <!--  Text Content  -->
                                            <VerticalStackLayout
                                                Grid.Column="1"
                                                Spacing="4"
                                                VerticalOptions="Center">

                                                <!--  Tag  -->
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontFamily="OpenSansSemiBold"
                                                    FontSize="11"
                                                    Text="ACTION REQUIRED"
                                                    TextColor="Red" />

                                                <!--  Title  -->
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontFamily="OpenSansSemiBold"
                                                    FontSize="15"
                                                    Text="Complete Baseline Questionnaire"
                                                    TextColor="#031926" />

                                                <!--  Subtitle  -->
                                                <Label
                                                    FontSize="13"
                                                    Text="Please complete your baseline questionnaire to continue."
                                                    TextColor="#6b7280" />

                                            </VerticalStackLayout>

                                        </Grid>
                                    </Border>


                                </StackLayout>
                            </Border>


