                            <Border
                                Margin="20,20,20,0"
                                Padding="15"
                                BackgroundColor="#7f0000"
                                IsVisible="False"
                                Stroke="Red"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="2">

                                <StackLayout VerticalOptions="Start">



                                    <Image
                                        Margin="5,0,0,10"
                                        HeightRequest="35"
                                        HorizontalOptions="Start"
                                        Source="symptomred.png"
                                        VerticalOptions="Start"
                                        WidthRequest="35" />

                                    <!--  Tag  -->
                                    <Label
                                        Grid.Row="0"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="12"
                                        Text="STUDY PROGRESS"
                                        TextColor="White" />

                                    <!--  Title  -->
                                    <Label
                                        Grid.Row="1"
                                        Margin="0,5,0,0"
                                        FontAttributes="Bold"
                                        FontFamily="OpenSansSemiBold"
                                        FontSize="22"
                                        LineBreakMode="WordWrap"
                                        Text="Today is DAY THREE of triggered sampling"
                                        TextColor="Red" />

                                    <!--  Subtitle  -->
                                    <Label
                                        Grid.Row="2"
                                        Margin="0,5,0,0"
                                        FontSize="14"
                                        Text="Please carry out the samples for today and fill in your T1 form"
                                        TextColor="White" />



                                    <Image
                                        Margin="0,0,0,0"
                                        HeightRequest="25"
                                        HorizontalOptions="End"
                                        Source="rightarrow.png"
                                        VerticalOptions="Start"
                                        WidthRequest="25" />



                                </StackLayout>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer NumberOfTapsRequired="1" Tapped="TapGestureRecognizer_Tapped_1" />
                                </Border.GestureRecognizers>
                            </Border>





                            <Label
                                Margin="20,20,0,0"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemiBold"
                                FontSize="12"
                                HorizontalOptions="Start"
                                Text="Household Participants"
                                TextColor="#031926" />

                            <syncfusion:SfListView
                                x:Name="profilelist"
                                Margin="20,5,20,0"
                                AutoFitMode="DynamicHeight"
                                BackgroundColor="Transparent"
                                IsScrollingEnabled="False"
                                ItemSpacing="0"
                                Orientation="Vertical"
                                ScrollBarVisibility="Never"
                                SelectionBackground="Transparent"
                                SelectionMode="None"
                                VerticalOptions="Fill">
                                <syncfusion:SfListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="6,4"
                                            Padding="16"
                                            BackgroundColor="#F8F9FB"
                                            Opacity="{Binding ListOpacity}"
                                            Stroke="#E5E7EB"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="1">
                                            <Border.Shadow>
                                                <Shadow
                                                    Brush="#000000"
                                                    Opacity="0.05"
                                                    Radius="4"
                                                    Offset="0,2" />
                                            </Border.Shadow>

                                            <VerticalStackLayout Spacing="12">

                                                <Grid
                                                    ColumnDefinitions="Auto, *"
                                                    ColumnSpacing="12"
                                                    VerticalOptions="Center">
                                                    <Image
                                                        Grid.Column="0"
                                                        HeightRequest="24"
                                                        Source="{Binding Studyactiveimage}"
                                                        VerticalOptions="Center"
                                                        WidthRequest="24" />

                                                    <VerticalStackLayout
                                                        Grid.Column="1"
                                                        Spacing="2"
                                                        VerticalOptions="Center">
                                                        <Label
                                                            FontAttributes="Bold"
                                                            FontFamily="OpenSansSemiBold"
                                                            FontSize="16"
                                                            Text="{Binding household_individual_name}"
                                                            TextColor="#031926" />
                                                        <Label
                                                            FontFamily="OpenSansRegular"
                                                            FontSize="12"
                                                            Text="{Binding Studyinfo}"
                                                            TextColor="#6B7280" />
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <Grid
                                                    ColumnDefinitions="*, *"
                                                    ColumnSpacing="10"
                                                    IsVisible="{Binding ShowDetails}">
                                                    <!--  Baseline Form  -->
                                                    <Border
                                                        Grid.Column="0"
                                                        Padding="10,8"
                                                        BackgroundColor="Transparent"
                                                        Stroke="{Binding BaselineFormBorderColor}"
                                                        StrokeShape="RoundRectangle 8"
                                                        StrokeThickness="1">
                                                        <VerticalStackLayout Spacing="6">
                                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                                <Image
                                                                    HeightRequest="13"
                                                                    Source="questionnaireicon.png"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="13" />
                                                                <Label
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="11"
                                                                    Text="Baseline form"
                                                                    TextColor="#6B7280"
                                                                    VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                            <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                                                                <Image
                                                                    HeightRequest="13"
                                                                    IsVisible="{Binding BaselineFormIconVisible}"
                                                                    Source="{Binding BaselineFormTickImage}"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="13" />
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="14"
                                                                    Text="{Binding BaselineFormStatusText}"
                                                                    TextColor="{Binding BaselineFormTextColor}" />
                                                            </HorizontalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>

                                                    <!--  Baseline Samples  -->
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="10,8"
                                                        BackgroundColor="Transparent"
                                                        Stroke="{Binding BaselineSamplesBorderColor}"
                                                        StrokeShape="RoundRectangle 8"
                                                        StrokeThickness="1">
                                                        <VerticalStackLayout Spacing="6">
                                                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                                <Image
                                                                    HeightRequest="13"
                                                                    Source="questionnaireicon.png"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="13" />
                                                                <Label
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="11"
                                                                    Text="Baseline samples"
                                                                    TextColor="#6B7280"
                                                                    VerticalOptions="Center" />
                                                            </HorizontalStackLayout>
                                                            <HorizontalStackLayout HorizontalOptions="End" Spacing="4">
                                                                <Image
                                                                    HeightRequest="13"
                                                                    IsVisible="{Binding BaselineSamplesIconVisible}"
                                                                    Source="{Binding BaselineSamplesTickImage}"
                                                                    VerticalOptions="Center"
                                                                    WidthRequest="13" />
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="14"
                                                                    Text="{Binding BaselineSamplesStatusText}"
                                                                    TextColor="{Binding BaselineSamplesTextColor}" />
                                                            </HorizontalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </Grid>

                                                <VerticalStackLayout IsVisible="{Binding ShowDetails}" Spacing="12">

                                                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                                        <!--  Last Active  -->
                                                        <Border
                                                            Grid.Column="0"
                                                            Padding="10,8"
                                                            BackgroundColor="Transparent"
                                                            Stroke="#E5E7EB"
                                                            StrokeShape="RoundRectangle 8">
                                                            <VerticalStackLayout Spacing="4">
                                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                                    <Image
                                                                        HeightRequest="13"
                                                                        Source="clock.png"
                                                                        VerticalOptions="Center"
                                                                        WidthRequest="13" />
                                                                    <Label
                                                                        FontFamily="OpenSansSemiBold"
                                                                        FontSize="11"
                                                                        Text="Last active"
                                                                        TextColor="#6B7280"
                                                                        VerticalOptions="Center" />
                                                                </HorizontalStackLayout>
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="14"
                                                                    HorizontalOptions="End"
                                                                    Text="{Binding LastActiveDate}"
                                                                    TextColor="#031926" />
                                                            </VerticalStackLayout>
                                                        </Border>

                                                        <!--  Questionnaires Completed  -->
                                                        <Border
                                                            Grid.Column="1"
                                                            Padding="10,8"
                                                            BackgroundColor="Transparent"
                                                            Stroke="#E5E7EB"
                                                            StrokeShape="RoundRectangle 8">
                                                            <VerticalStackLayout Spacing="4">
                                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                                    <Image
                                                                        HeightRequest="13"
                                                                        Source="questionnaireicon.png"
                                                                        VerticalOptions="Center"
                                                                        WidthRequest="13" />
                                                                    <Label
                                                                        FontFamily="OpenSansSemiBold"
                                                                        FontSize="11"
                                                                        Text="Questionnaires"
                                                                        TextColor="#6B7280"
                                                                        VerticalOptions="Center" />
                                                                </HorizontalStackLayout>
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="14"
                                                                    HorizontalOptions="End"
                                                                    Text="{Binding QuestionnairesCompleted}"
                                                                    TextColor="#031926" />
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </Grid>

                                                    <!--  Warning Alert Box  -->
                                                    <Border
                                                        Padding="12"
                                                        BackgroundColor="#F0F9FF"
                                                        IsVisible="{Binding ShowAwaitingBaseline}"
                                                        Stroke="#009FE3"
                                                        StrokeShape="RoundRectangle 8"
                                                        StrokeThickness="1">
                                                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                                                            <Image
                                                                Grid.Column="0"
                                                                Margin="0,2,0,0"
                                                                HeightRequest="20"
                                                                Source="infoicon.png"
                                                                VerticalOptions="Start"
                                                                WidthRequest="20" />
                                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="13"
                                                                    Text="Awaiting baseline questionnaire"
                                                                    TextColor="#009FE3" />
                                                                <Label
                                                                    FontFamily="OpenSansRegular"
                                                                    FontSize="11"
                                                                    LineHeight="1.3"
                                                                    Text="As the household representative, you can complete the baseline form on their behalf. Please ensure all information is accurate."
                                                                    TextColor="#031926" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </Border>

                                                    <!--  Action Buttons Footer  -->
                                                    <Grid
                                                        ColumnDefinitions="*, *, *"
                                                        ColumnSpacing="8"
                                                        IsVisible="{Binding ShowActions}">
                                                        <Border
                                                            Grid.Column="0"
                                                            Padding="8,10"
                                                            BackgroundColor="#E6F5FC"
                                                            Opacity="{Binding BaselineButtonOpacity}"
                                                            Stroke="#009FE3"
                                                            StrokeShape="RoundRectangle 10">
                                                            <VerticalStackLayout
                                                                HorizontalOptions="Center"
                                                                Spacing="6"
                                                                VerticalOptions="Center">
                                                                <Image
                                                                    HeightRequest="18"
                                                                    Source="questionnaireicon.png"
                                                                    WidthRequest="18" />
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="11"
                                                                    HorizontalTextAlignment="Center"
                                                                    Text="Complete Baseline"
                                                                    TextColor="#009FE3" />
                                                            </VerticalStackLayout>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_3" />
                                                            </Border.GestureRecognizers>
                                                        </Border>

                                                        <!--  Secondary Action: Send Reminder  -->
                                                        <Border
                                                            Grid.Column="1"
                                                            Padding="8,10"
                                                            BackgroundColor="Transparent"
                                                            Stroke="#E5E7EB"
                                                            StrokeShape="RoundRectangle 10">
                                                            <VerticalStackLayout
                                                                HorizontalOptions="Center"
                                                                Spacing="6"
                                                                VerticalOptions="Center">
                                                                <Image
                                                                    HeightRequest="18"
                                                                    Source="notificationicon.png"
                                                                    WidthRequest="18" />
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="11"
                                                                    HorizontalTextAlignment="Center"
                                                                    Text="{Binding SendReminderText}"
                                                                    TextColor="#031926" />
                                                            </VerticalStackLayout>
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped_4" />
                                                            </Border.GestureRecognizers>
                                                        </Border>

                                                        <!--  Secondary Action: Manage Profile  -->
                                                        <Border
                                                            Grid.Column="2"
                                                            Padding="8,10"
                                                            BackgroundColor="Transparent"
                                                            Opacity="{Binding ManageButtonOpacity}"
                                                            Stroke="#E5E7EB"
                                                            StrokeShape="RoundRectangle 10">
                                                            <VerticalStackLayout
                                                                HorizontalOptions="Center"
                                                                Spacing="6"
                                                                VerticalOptions="Center">
                                                                <Image
                                                                    HeightRequest="18"
                                                                    Source="manageuser.png"
                                                                    WidthRequest="18" />
                                                                <Label
                                                                    FontAttributes="Bold"
                                                                    FontFamily="OpenSansSemiBold"
                                                                    FontSize="11"
                                                                    HorizontalTextAlignment="Center"
                                                                    Text="Manage profile"
                                                                    TextColor="#031926" />
                                                            </VerticalStackLayout>
