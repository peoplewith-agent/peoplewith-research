<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PeopleWithResearch.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    BackgroundColor="White">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="toolbar" Clicked="toolbar_Clicked" />
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackLayout>
                <StackLayout Grid.Row="0">
                    <StackLayout x:Name="noconnection" IsVisible="false">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>

                            <Image
                                x:Name="nodatahomeimg"
                                Grid.Row="0"
                                Margin="10,250,10,0"
                                HeightRequest="80"
                                HorizontalOptions="Center"
                                Source="networkerror.png"
                                WidthRequest="80" />

                            <Label
                                Grid.Row="1"
                                Margin="0,-5,0,0"
                                FontAttributes="None"
                                FontSize="Micro"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="You seem to have lost connection"
                                TextColor="Gray" />

                            <Label
                                Grid.Row="2"
                                Margin="0,-5,0,0"
                                FontAttributes="None"
                                FontSize="Micro"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="Please check your connection and try again"
                                TextColor="Gray" />

                        </Grid>
                    </StackLayout>
                    <StackLayout x:Name="AllViewStack">

                        <StackLayout
                            x:Name="loginstack"
                            Margin="40,50,40,0"
                            HorizontalOptions="FillAndExpand"
                            VerticalOptions="StartAndExpand">

                            <Label
                                FontAttributes="Bold"
                                FontSize="40"
                                Text="Login"
                                TextColor="#143541" />

                            <Label
                                FontSize="Small"
                                Text="Enter your email address and password to login to your PeopleWith Research Account"
                                TextColor="#143541" />

                            <!--<Label Text="EMAIL ADDRESS" TextColor="#143541" Margin="0,20,0,0" FontSize="Small" FontAttributes="Bold"  />-->

                            <inputLayout:SfTextInputLayout
                                x:Name="emailhint"
                                Margin="0,20,0,0"
                                BackgroundColor="Transparent"
                                ContainerBackground="Transparent"
                                ContainerType="Outlined"
                                HeightRequest="80"
                                Hint="Email"
                                OutlineCornerRadius="10">
                                <Entry
                                    x:Name="emailtxt"
                                    Margin="0,20,0,0"
                                    Placeholder="Email"
                                    PlaceholderColor="Gray"
                                    TextChanged="emailtxt_TextChanged"
                                    TextColor="#143541" />
                            </inputLayout:SfTextInputLayout>

                            <!--<Label Text="PASSWORD" TextColor="#143541" Margin="0,0,0,0" FontSize="Small" FontAttributes="Bold"  />-->

                            <inputLayout:SfTextInputLayout
                                x:Name="passhint"
                                Margin="0,0,0,0"
                                BackgroundColor="Transparent"
                                ContainerBackground="Transparent"
                                ContainerType="Outlined"
                                HeightRequest="80"
                                Hint="Password"
                                OutlineCornerRadius="10">
                                <Entry
                                    x:Name="passtxt"
                                    Margin="0,0,0,0"
                                    IsPassword="True"
                                    Placeholder="Password"
                                    PlaceholderColor="Gray"
                                    TextChanged="passtxt_TextChanged"
                                    TextColor="#143541" />
                            </inputLayout:SfTextInputLayout>


                            <Button
                                Margin="0,10,0,0"
                                BackgroundColor="#143541"
                                Clicked="Button_Clicked"
                                CornerRadius="20"
                                FontAttributes="Bold"
                                HorizontalOptions="FillAndExpand"
                                Text="LOGIN"
                                TextColor="White" />
                            <Button
                                x:Name="forgotpass"
                                Margin="0,10,0,0"
                                BackgroundColor="Transparent"
                                Clicked="forgotpass_Clicked"
                                CornerRadius="20"
                                FontAttributes="Bold"
                                HorizontalOptions="FillAndExpand"
                                Text="Forgotten Password?"
                                TextColor="#143541" />



                        </StackLayout>


                        <StackLayout
                            x:Name="forgotpasswordstack"
                            Margin="40,50,40,0"
                            HorizontalOptions="FillAndExpand"
                            IsVisible="false"
                            VerticalOptions="StartAndExpand">

                            <Label
                                FontAttributes="Bold"
                                FontSize="40"
                                Text="Forgotten your password?"
                                TextColor="#143541" />

                            <Label
                                FontSize="Small"
                                Text="Enter your email address associated with your PeopleWith Account below."
                                TextColor="#143541" />

                            <Label
                                Margin="0,10,0,0"
                                FontSize="Small"
                                Text="You will receive an email with details on how to reset your password."
                                TextColor="#143541" />

                            <!--<Label Text="EMAIL ADDRESS" TextColor="#143541" Margin="0,20,0,0" FontSize="Small" FontAttributes="Bold"  />-->

                            <inputLayout:SfTextInputLayout
                                x:Name="emailfphint"
                                Margin="0,20,0,0"
                                BackgroundColor="Transparent"
                                ContainerBackground="Transparent"
                                ContainerType="Outlined"
                                HeightRequest="80"
                                Hint="Email"
                                OutlineCornerRadius="10">
                                <Entry
                                    x:Name="emailfptxt"
                                    Margin="0,20,0,0"
                                    Placeholder="Email"
                                    PlaceholderColor="Gray"
                                    TextChanged="emailfptxt_TextChanged"
                                    TextColor="#143541" />
                            </inputLayout:SfTextInputLayout>




                            <Button
                                x:Name="passwordresetbtn"
                                Margin="0,10,0,0"
                                BackgroundColor="#143541"
                                Clicked="passwordresetbtn_Clicked"
                                CornerRadius="20"
                                FontAttributes="Bold"
                                HorizontalOptions="FillAndExpand"
                                Text="SEND PASSWORD RESET"
                                TextColor="White" />



                        </StackLayout>


                    </StackLayout>
                </StackLayout>

                <StackLayout
                    x:Name="bottomstack"
                    Grid.Row="1"
                    Margin="0,0,0,30"
                    BackgroundColor="Transparent"
                    VerticalOptions="EndAndExpand">


                    <Label
                        x:Name="privpollbl"
                        FontAttributes="Bold"
                        FontSize="Small"
                        HorizontalOptions="Center"
                        Text="Privacy Policy"
                        TextColor="#009fe3"
                        VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />

                        </Label.GestureRecognizers>
                    </Label>


                </StackLayout>

            </StackLayout>
        </Grid>
    </ContentPage.Content>
</ContentPage>