<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="PeopleWithResearch.PopupPageHelper"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    BackgroundColor="White"
    BackgroundInputTransparent="True"
    CloseWhenBackgroundIsClicked="False">
    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="200"
            DurationOut="200"
            EasingIn="SinOut"
            EasingOut="SinIn"
            HasBackgroundAnimation="False"
            PositionIn="Center"
            PositionOut="Center" />
    </Mopups:PopupPage.Animation>
    <VerticalStackLayout
        Margin="20,0,20,0"
        BackgroundColor="Transparent"
        VerticalOptions="Center">
        <Border
            Margin="0,5,0,5"
            Padding="0"
            InputTransparent="True"
            Stroke="Transparent"
            StrokeShape="RoundRectangle 10">
            <StackLayout>

                <StackLayout
                    x:Name="CreateAccountStack"
                    Padding="30,40"
                    IsVisible="False"
                    Spacing="10">

                    <VerticalStackLayout
                        x:Name="FinsihedStack"
                        IsVisible="False"
                        Opacity="0"
                        Spacing="15">
                        <Image
                            x:Name="LoadImage"
                            Aspect="AspectFit"
                            HorizontalOptions="Center"
                            IsAnimationPlaying="False"
                            Source="createaccount.gif" />

                        <Label
                            FontFamily="HankenGroteskBold"
                            FontSize="24"
                            HorizontalTextAlignment="Center"
                            Text="Account Created!"
                            TextColor="#031926" />

                        <Label
                            x:Name="BottomStacklbl"
                            FontFamily="HankenGroteskRegular"
                            FontSize="14"
                            HorizontalTextAlignment="Center"
                            Text="Welcome to the community. Your journey begins now."
                            TextColor="#667085" />
                    </VerticalStackLayout>

                    <VerticalStackLayout x:Name="LoadingStack" Spacing="10">
                        <Label
                            x:Name="loadinglbl"
                            FontFamily="HankenGroteskBold"
                            FontSize="20"
                            HorizontalTextAlignment="Center"
                            Text="Creating your account..."
                            TextColor="#031926" />

                        <progressBar:SfLinearProgressBar
                            x:Name="CreateProgressbar"
                            Margin="0,15,0,0"
                            AnimationEasing="{x:Static Easing.CubicInOut}"
                            Maximum="100"
                            Minimum="0"
                            Progress="{Binding ProgressValue}"
                            ProgressCornerRadius="4"
                            ProgressFill="#009fe3"
                            ProgressHeight="8"
                            TrackCornerRadius="4"
                            TrackFill="#ccebf9"
                            TrackHeight="8" />

                        <Label
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            Text="Please wait while we set things up"
                            TextColor="#94a3b8" />
                    </VerticalStackLayout>

                </StackLayout>

                <StackLayout x:Name="mainstack">


                    <ActivityIndicator
                        x:Name="listloader"
                        Margin="0,0,0,10"
                        HorizontalOptions="Center"
                        IsRunning="False"
                        VerticalOptions="Center"
                        Color="#031926" />
                    <Image
                        x:Name="img"
                        HeightRequest="50"
                        HorizontalOptions="Center"
                        Source="successtick.png"
                        VerticalOptions="Start"
                        WidthRequest="50" />
                    <Label
                        x:Name="detaillbl"
                        Margin="0,10,0,0"
                        FontFamily="HankenGroteskBold"
                        FontSize="20"
                        HorizontalOptions="CenterAndExpand"
                        HorizontalTextAlignment="Center"
                        TextColor="#031926"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                    <Label
                        x:Name="detaillbl2"
                        Margin="0,10,0,0"
                        FontFamily="HankenGroteskBold"
                        FontSize="12"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        IsVisible="False"
                        Text="Please wait while we process your request. This may take a few moments."
                        TextColor="#031926"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </StackLayout>

                <StackLayout
                    x:Name="switchstack"
                    Padding="20"
                    IsVisible="False">


                    <Border
                        x:Name="imgstack"
                        Padding="0"
                        BackgroundColor="#CCEBF9"
                        HeightRequest="80"
                        Stroke="#CCEBF9"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="2"
                        WidthRequest="80">
                        <Grid>
                            <Image
                                x:Name="ppsource"
                                Aspect="AspectFill"
                                HorizontalOptions="Center"
                                IsVisible="False"
                                VerticalOptions="Center" />

                            <Label
                                x:Name="ilbl"
                                Padding="0"
                                FontFamily="HankenGroteskBold"
                                FontSize="20"
                                HorizontalOptions="Center"
                                IsVisible="True"
                                Text="MH"
                                TextColor="#031926"
                                TextTransform="Uppercase"
                                VerticalOptions="Center" />
                        </Grid>
                    </Border>


                    <ActivityIndicator
                        x:Name="listloaderpp"
                        Margin="0,10,0,0"
                        HorizontalOptions="Center"
                        IsRunning="True"
                        VerticalOptions="Center"
                        Color="#031926" />



                    <!--<Image  x:Name="imgpp" IsVisible="False" HeightRequest="100" WidthRequest="100" Aspect="AspectFill" HorizontalOptions="Center" VerticalOptions="Start" />-->
                    <Label
                        x:Name="detaillblpp"
                        Margin="0,10,0,0"
                        FontFamily="HankenGroteskBold"
                        FontSize="14"
                        HorizontalOptions="CenterAndExpand"
                        HorizontalTextAlignment="Center"
                        TextColor="#031926"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </StackLayout>

                <Grid
                    x:Name="ConfirmationStack"
                    Padding="0,20,0,0"
                    ColumnDefinitions="*"
                    HorizontalOptions="Fill"
                    IsVisible="False"
                    RowDefinitions="Auto, *, Auto"
                    VerticalOptions="Center">

                    <StackLayout
                        Grid.Row="0"
                        Margin="0,0,0,50"
                        HorizontalOptions="Center"
                        Spacing="5"
                        VerticalOptions="Start">
                        <Border
                            Padding="0"
                            BackgroundColor="#fff7ea"
                            HorizontalOptions="Center"
                            Stroke="Orange"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="2"
                            VerticalOptions="Start">
                            <Grid Padding="20" Grid.RowDefinitions="Auto,Auto">
                                <Image
                                    Grid.Row="0"
                                    HeightRequest="75"
                                    HorizontalOptions="Center"
                                    Source="symptomshome.png"
                                    VerticalOptions="Center"
                                    WidthRequest="75" />
                                <Label
                                    Grid.Row="1"
                                    FontSize="16"
                                    HorizontalOptions="Center"
                                    Text="Symptoms"
                                    TextColor="#031926"
                                    VerticalOptions="End" />
                            </Grid>
                        </Border>
                    </StackLayout>

                    <Label
                        x:Name="Messagelbl"
                        Grid.Row="1"
                        Margin="10,0,10,20"
                        FontFamily="HankenGroteskBold"
                        FontSize="18"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Start"
                        TextColor="#031926"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                    <Button
                        x:Name="ConfirmNext"
                        Grid.Row="2"
                        Margin="0,20,0,0"
                        Padding="10"
                        BackgroundColor="Transparent"
                        BorderColor="Orange"
                        BorderWidth="2"
                        Clicked="ConfirmNext_Clicked"
                        FontFamily="HankenGroteskBold"
                        FontSize="16"
                        HorizontalOptions="FillAndExpand"
                        Text="Next"
                        TextColor="Orange"
                        VerticalOptions="End" />

                </Grid>

            </StackLayout>
        </Border>
    </VerticalStackLayout>
</Mopups:PopupPage>