<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="PeopleWithResearch.ConfirmMessage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:local="clr-namespace:PeopleWithResearch"
    xmlns:progressBar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    BackgroundColor="#D92D3748"
    CloseWhenBackgroundIsClicked="False">

    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="300"
            EasingIn="CubicOut"
            PositionIn="Center"
            ScaleIn="0.9" />
    </Mopups:PopupPage.Animation>

    <Mopups:PopupPage.Resources>
        <Color x:Key="PrimaryBlue">#009fe3</Color>
        <Color x:Key="LightBlueBg">#F0F9FF</Color>
        <Color x:Key="DarkText">#031926</Color>
        <Color x:Key="BodyText">#50606C</Color>

        <Style x:Key="PopupPrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryBlue}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>

        <Style x:Key="PopupSecondaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{StaticResource PrimaryBlue}" />
            <Setter Property="BorderColor" Value="{StaticResource PrimaryBlue}" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="HeightRequest" Value="50" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="HorizontalOptions" Value="Fill" />
        </Style>

        <Style x:Key="TemplateHeaderLabel" TargetType="Label">
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontFamily" Value="OpenSansSemiBold" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{StaticResource DarkText}" />
        </Style>

        <DataTemplate x:Key="ImageTemplate">
            <VerticalStackLayout Padding="40,20" Spacing="10">
                <Grid
                    HeightRequest="70"
                    HorizontalOptions="Center"
                    IsVisible="{Binding Hideimage}"
                    WidthRequest="70">
                    <Ellipse Fill="{StaticResource LightBlueBg}" />
                    <Label
                        x:Name="ImageMessage"
                        FontSize="32"
                        HorizontalOptions="Center"
                        Text="📸"
                        VerticalOptions="Center" />
                </Grid>

                <Label
                    IsVisible="{Binding Hideimage}"
                    Style="{StaticResource TemplateHeaderLabel}"
                    Text="Capture LFD Result" />

                <Label
                    FontFamily="OpenSansRegular"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding Hideimage}"
                    LineBreakMode="WordWrap"
                    Text="{Binding confirmationmessagetitle}"
                    TextColor="{StaticResource BodyText}" />

                <Label
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemiBold"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    IsVisible="{Binding Hasimage}"
                    LineBreakMode="WordWrap"
                    Text="{Binding Details}"
                    TextColor="{StaticResource BodyText}" />

                <Grid
                    Margin="0,15"
                    HorizontalOptions="Center"
                    IsVisible="{Binding Hasimage}">

                    <Border
                        BackgroundColor="Transparent"
                        Stroke="Transparent"
                        StrokeThickness="1">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow
                                Brush="Black"
                                Opacity="0.1"
                                Radius="12"
                                Offset="0,6" />
                        </Border.Shadow>

                        <Image
                            Aspect="AspectFill"
                            HeightRequest="300"
                            Source="{Binding ImageSource}"
                            WidthRequest="300" />
                    </Border>

                    <Button
                        x:Name="RemoveImage"
                        Margin="0,-10,-10,0"
                        Padding="-2"
                        BackgroundColor="#ff817f"
                        Clicked="RemoveImage_Clicked"
                        CornerRadius="25"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemiBold"
                        FontSize="12"
                        HeightRequest="10"
                        HorizontalOptions="End"
                        Text="✕"
                        TextColor="White"
                        VerticalOptions="Start"
                        WidthRequest="10" />
                </Grid>

                <VerticalStackLayout Margin="0,10,0,0" Spacing="10">
                    <Button
                        x:Name="PictureBtn"
                        Clicked="OpenCamera_Clicked"
                        Style="{StaticResource PopupPrimaryButton}"
                        Text="{Binding Picturebtn}" />
                    <Button
                        Clicked="OpenGallery_Clicked"
                        Style="{StaticResource PopupSecondaryButton}"
                        Text="{Binding Completebtn}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="CompleteTemplate">
            <VerticalStackLayout Padding="40,20" Spacing="10">
                <Image
                    Aspect="Center"
                    HeightRequest="100"
                    HorizontalOptions="Center"
                    IsAnimationPlaying="True"
                    Source="createaccount.gif"
                    WidthRequest="100" />

                <Label Style="{StaticResource TemplateHeaderLabel}" Text="Form Completed" />

                <Label
                    FontFamily="OpenSansRegular"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Text="{Binding confirmationmessagetitle}"
                    TextColor="{StaticResource BodyText}" />

                <VerticalStackLayout Margin="0,10,0,0" Spacing="10">
                    <Button
                        Clicked="Complete_Clicked"
                        Style="{StaticResource PopupPrimaryButton}"
                        Text="Continue" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </DataTemplate>

        <DataTemplate x:Key="LogoutTemplate">
            <VerticalStackLayout Padding="40,20" Spacing="20">
                <Grid
                    HeightRequest="70"
                    HorizontalOptions="Center"
                    WidthRequest="70">
                    <Ellipse Fill="{StaticResource LightBlueBg}" />
                    <Label
                        FontSize="32"
                        HorizontalOptions="Center"
                        Text="👋"
                        VerticalOptions="Center" />
                </Grid>

                <Label Style="{StaticResource TemplateHeaderLabel}" Text="Successfully Withdrawn" />

                <Label
                    FontFamily="OpenSansRegular"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    Text="{Binding confirmationmessagetitle}"
                    TextColor="{StaticResource BodyText}" />

                <VerticalStackLayout Margin="0,10,0,0" Spacing="10">
                    <Button
                        Clicked="logout_Clicked"
                        Style="{StaticResource PopupPrimaryButton}"
                        Text="Complete &amp; Logout" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </DataTemplate>

        <local:ConfirmTemplateSelector
            x:Key="ConfirmSelector"
            CompleteTemplate="{StaticResource CompleteTemplate}"
            ImageTemplate="{StaticResource ImageTemplate}"
            LogoutTemplate="{StaticResource LogoutTemplate}" />

    </Mopups:PopupPage.Resources>

    <Border
        Margin="24,45"
        HorizontalOptions="Center"
        StrokeThickness="1.5"
        VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="28" />
        </Border.StrokeShape>
        <Border.Stroke>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0.1" Color="#E2E8F0" />
                <GradientStop Offset="1.0" Color="#CBD5E0" />
            </LinearGradientBrush>
        </Border.Stroke>
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#FFFFFF" />
                <GradientStop Offset="1" Color="#F8FAFC" />
            </LinearGradientBrush>
        </Border.Background>
        <Border.Shadow>
            <Shadow
                Brush="Black"
                Opacity="0.25"
                Radius="20"
                Offset="0,12" />
        </Border.Shadow>

        <Grid WidthRequest="340">
            <CollectionView
                x:Name="MainCollectionView"
                Margin="0,10,0,0"
                ItemTemplate="{StaticResource ConfirmSelector}"
                SelectionMode="None"
                VerticalOptions="Center"
                VerticalScrollBarVisibility="Never" />

            <Grid
                x:Name="CameraStack"
                HorizontalOptions="Fill"
                IsVisible="False"
                VerticalOptions="Fill">
                <toolkit:CameraView
                    x:Name="cameraView"
                    CameraFlashMode="Auto"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill" />

                <Grid Padding="20" VerticalOptions="End">
                    <Button
                        x:Name="CaptureButton"
                        BackgroundColor="White"
                        BorderColor="{StaticResource LightBlueBg}"
                        BorderWidth="4"
                        Clicked="CaptureButton_Clicked"
                        CornerRadius="35"
                        HeightRequest="70"
                        HorizontalOptions="Center"
                        WidthRequest="70" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Mopups:PopupPage>