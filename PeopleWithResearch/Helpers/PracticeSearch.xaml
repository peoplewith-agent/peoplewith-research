<?xml version="1.0" encoding="utf-8" ?>
<Mopups:PopupPage
    x:Class="PeopleWithResearch.PractiseSearch"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:Animations="clr-namespace:Mopups.Animations;assembly=Mopups"
    xmlns:Mopups="clr-namespace:Mopups.Pages;assembly=Mopups"
    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:syncfusion="clr-namespace:Syncfusion.Maui.ListView;assembly=Syncfusion.Maui.ListView"
    BackgroundColor="#80000000"
    BackgroundInputTransparent="False"
    CloseWhenBackgroundIsClicked="False">
    <Mopups:PopupPage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="Default">
                <Border
                    Margin="5"
                    Padding="20"
                    BackgroundColor="Transparent"
                    InputTransparent="True"
                    Stroke="LightGray"
                    StrokeShape="RoundRectangle 10">
                    <Grid
                        Margin="0"
                        Padding="0"
                        ColumnDefinitions="*"
                        HorizontalOptions="Fill"
                        InputTransparent="True"
                        RowDefinitions="Auto">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            FontFamily="OpenSansRegular"
                            FontSize="12"
                            InputTransparent="True"
                            Text="{Binding Text}"
                            TextColor="Gray"
                            VerticalOptions="Start" />

                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="SelectedDefault">
                <Border
                    Margin="5"
                    Padding="20"
                    BackgroundColor="#d8e9fa"
                    InputTransparent="True"
                    Stroke="#009fe3"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="2">
                    <Grid
                        Margin="0"
                        Padding="0"
                        ColumnDefinitions="*"
                        HorizontalOptions="Fill"
                        InputTransparent="True"
                        RowDefinitions="Auto">

                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Margin="0,0,0,0"
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemiBold"
                            FontSize="12"
                            Text="{Binding Text}"
                            TextColor="#031926"
                            VerticalOptions="Center" />

                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Mopups:PopupPage.Resources>


    <Mopups:PopupPage.Animation>
        <Animations:ScaleAnimation
            DurationIn="200"
            DurationOut="200"
            EasingIn="SinOut"
            EasingOut="SinIn"
            HasBackgroundAnimation="False"
            PositionIn="Center"
            PositionOut="Center" />
    </Mopups:PopupPage.Animation>

    <Grid RowDefinitions="Auto, *" VerticalOptions="Center">


        <Border
            Margin="10,0"
            Padding="0"
            Background="White"
            HorizontalOptions="Center"
            Stroke="White"
            StrokeShape="RoundRectangle 10"
            StrokeThickness="1"
            VerticalOptions="Center">

            <Grid Margin="20,0" RowDefinitions="Auto,*">

                <Border
                    Margin="10,0"
                    Padding="0"
                    Background="White"
                    HorizontalOptions="Center"
                    Stroke="White"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                    <Grid ColumnDefinitions="10*,8*,10*" RowDefinitions="Auto">
                        <Image
                            Grid.Column="0"
                            HeightRequest="40"
                            HorizontalOptions="Center"
                            Opacity="0.5"
                            WidthRequest="40">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="OpenSansSemiBold"
                                    Glyph="🔍"
                                    Size="40"
                                    Color="#62727B" />
                            </Image.Source>
                        </Image>

                        <Entry
                            x:Name="GpEntry"
                            Grid.Row="1"
                            FontFamily="OpenSansRegular"
                            FontSize="14"
                            IsEnabled="False"
                            Keyboard="Default"
                            Placeholder="Enter GP Practice"
                            PlaceholderColor="Gray"
                            TextChanged="GpEntry_TextChanged"
                            TextColor="#031926"
                            VerticalOptions="Center" />

                        <Image
                            Grid.Column="0"
                            HeightRequest="40"
                            HorizontalOptions="Center"
                            Opacity="0.5"
                            WidthRequest="40">
                            <Image.Source>
                                <FontImageSource
                                    FontFamily="OpenSansSemiBold"
                                    Glyph="❌"
                                    Size="40"
                                    Color="#62727B" />
                            </Image.Source>
                        </Image>
                    </Grid>
                </Border>

                <syncfusion:SfListView
                    x:Name="gplistview"
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,10,0,0"
                    AutoFitMode="Height"
                    BackgroundColor="Transparent"
                    ItemTapped="gplistview_ItemTapped"
                    ItemTemplate="{StaticResource Default}"
                    Orientation="Vertical"
                    ScrollBarVisibility="Never"
                    SelectedItemTemplate="{StaticResource SelectedDefault}"
                    SelectionBackground="Transparent"
                    SelectionGesture="Tap"
                    SelectionMode="Single" />

            </Grid>
        </Border>
    </Grid>
</Mopups:PopupPage>
